{
  "name": "tilana-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:stop": "node scripts/dev.mjs --stop",
    "dev:web": "turbo run dev --filter=@tilana/web",
    "dev:admin": "turbo run dev --filter=@tilana/admin",
    "build": "turbo run build && node scripts/prepare-site-dist.mjs",
    "build:web": "turbo run build --filter=@tilana/web",
    "build:admin": "turbo run build --filter=@tilana/admin",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check": "turbo run lint typecheck && pnpm check:e2e",
    "check:e2e": "pnpm --filter @tilana/admin exec tsc --project ../../tests/e2e/tsconfig.json",
    "db:generate": "pnpm --filter @tilana/db db:generate",
    "db:migrate": "pnpm --filter @tilana/db db:migrate",
    "db:apply": "pnpm --filter @tilana/db db:apply",
    "db:check": "pnpm --filter @tilana/db db:check",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @tilana/admin test:integration",
    "test:e2e": "playwright test",
    "test:coverage": "turbo run test:coverage",
    "site:build": "pnpm --filter @tilana/web build && node scripts/prepare-site-dist.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "tsx": "4.23.12",
    "turbo": "latest",
    "undici": "8.10.0"
  }
}
