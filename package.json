{
  "name": "tilana-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:stop": "node scripts/dev.mjs --stop",
    "dev:web": "turbo run dev --filter=@tilana/web",
    "dev:admin-next": "turbo run dev --filter=@tilana/admin-next",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@tilana/web",
    "build:admin-next": "turbo run build --filter=@tilana/admin-next",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check": "turbo run lint typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "db:generate": "pnpm --filter @tilana/db db:generate",
    "db:migrate": "pnpm --filter @tilana/db db:migrate",
    "db:add-admin": "pnpm --filter @tilana/db db:add-admin"
  },
  "devDependencies": {
    "turbo": "2.11.5"
  }
}
