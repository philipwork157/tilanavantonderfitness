# Local backend configuration lives in the repository-root .env (never committed).
# Add only settings for features that are implemented.
# The public website uses apps/web/.env and its own .env.example.

# Admin sign-in (Supabase Auth). Use the project URL and the publishable (anon) key.
NUXT_SUPABASE_URL=
NUXT_SUPABASE_PUBLISHABLE_KEY=
# Comma-separated emails allowed into the admin. The Supabase account must exist and be confirmed.
NUXT_ADMIN_EMAILS=
