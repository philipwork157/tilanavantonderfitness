# VCS / tooling
.git
.gitignore
.github
*.md
.DS_Store

# Never send the retired backend or its private environment files to a build context
/tilana-fitness-old/

# Private/local creative work is never part of an application build context
/tilana-content-work/
/Claude outputs/

# dependencies & package-manager state (reinstalled in the image)
node_modules
**/node_modules
.pnpm-store

# build outputs & caches (rebuilt in the image)
**/dist
**/.astro
**/.turbo
**/.cache
**/.vite
**/.next
**/coverage
*.tsbuildinfo

# local env & scratch
**/.env
**/.env.*
!**/.env.example
.dev.vars
.dev.vars.*
.wrangler
/output
/tmp
