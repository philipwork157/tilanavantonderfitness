---
import '@fontsource-variable/montserrat/wght.css';
import '@fontsource-variable/montserrat/wght-italic.css';
import '@fontsource-variable/playfair-display/wght.css';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '@fontsource/allura/400.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/sections.css';
import '../styles/widgets.css';
import '../styles/shop.css';
import '../styles/programs.css';
import '../styles/kitchen.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Newsletter from '../components/Newsletter.astro';
import BasketDrawer from '../components/shop/BasketDrawer';
import WhatsAppChat from '../components/WhatsAppChat';
import { checkoutEnabled, href, site, type NavKey } from '../config';
import { toProducts, type Program } from '../programs';

interface Props {
  title: string;
  description?: string;
  current: NavKey;
  newsletter?: boolean;
  image?: string | null;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  pageType?: 'website' | 'article';
  publishedAt?: Date;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  robots?: string;
  /** Pages that loaded the programs pass them on, so the basket has them straight away. */
  programs?: Program[];
}

const {
  title,
  description = site.description,
  current,
  newsletter = true,
  image = '/og.png',
  imageAlt = 'Tilana van Tonder - strength, movement, and sustainable healthy habits',
  imageWidth = 1731,
  imageHeight = 909,
  imageType = 'image/png',
  pageType = 'website',
  publishedAt,
  structuredData,
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  programs,
} = Astro.props;
const products = programs?.length ? toProducts(programs) : undefined;

const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = image ? new URL(image, Astro.site) : null;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const websiteId = new URL('/#website', Astro.site).href;
const personId = new URL('/#person', Astro.site).href;
const pageId = `${canonical.href}#webpage`;
const extraStructuredData = structuredData
  ? Array.isArray(structuredData) ? structuredData : [structuredData]
  : [{
      '@type': 'WebPage',
      '@id': pageId,
      url: canonical.href,
      name: pageTitle,
      description,
      isPartOf: { '@id': websiteId },
      about: { '@id': personId },
    }];
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: Astro.site,
      name: site.name,
      description: site.description,
      inLanguage: 'en-ZA',
      publisher: { '@id': personId },
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: site.name,
      url: Astro.site,
      image: new URL('/tilana-home.jpg', Astro.site).href,
      description: site.description,
    },
    ...extraStructuredData,
  ],
};
---
<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('tilana-theme');
        } catch {
          theme = null;
        }
        if (theme !== 'light' && theme !== 'dark') theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={site.name} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#f6e4d9" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={pageType} />
    <meta property="og:locale" content="en_ZA" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:width" content={String(imageWidth)} />}
    {socialImage && <meta property="og:image:height" content={String(imageHeight)} />}
    {socialImage && <meta property="og:image:type" content={imageType} />}
    {socialImage && <meta property="og:image:alt" content={imageAlt} />}
    {pageType === 'article' && publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {pageType === 'article' && <meta property="article:author" content={site.name} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImage && <meta name="twitter:image:alt" content={imageAlt} />}
    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  </head>
  <body class="site">
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader current={current} />
    <main id="main"><slot /></main>
    {newsletter && <Newsletter />}
    <SiteFooter />
    {checkoutEnabled && <BasketDrawer client:idle checkoutHref={href('/checkout')} programsHref={href('/program')} products={products} />}
    <WhatsAppChat client:idle phone={site.whatsapp} avatar="/images/site/tilana-portrait-480.webp" />
    {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>}
    <script>
      import { animate, inView } from 'motion';
      import { startAnalytics } from '@web/utils/analytics';

      // Product analytics (PostHog, cookieless). Loads only when a project key is set.
      startAnalytics(
        import.meta.env.PUBLIC_POSTHOG_KEY ?? '',
        import.meta.env.PUBLIC_POSTHOG_HOST || 'https://eu.i.posthog.com',
        import.meta.env.DEV ? 'development' : 'production',
      );

      // Scroll reveal: elements start hidden only once JavaScript confirms it can animate them.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced) {
        document.documentElement.classList.add('motion-ok');
        inView(
          '[data-reveal]',
          (element) => {
            const delay = Number((element as HTMLElement).dataset.revealDelay ?? 0);
            animate(element, { opacity: [0, 1], y: [28, 0] }, { duration: 0.8, delay, ease: [0.22, 1, 0.36, 1] });
          },
          { amount: 0.15 },
        );
        // Program "Volume" seals stamp down just after their card fades in.
        inView(
          '.vol-ink',
          (element) => {
            const card = element.closest<HTMLElement>('[data-reveal]');
            const delay = Number(card?.dataset.revealDelay ?? 0) + 0.45;
            animate(element, { opacity: [0, 1], scale: [2.3, 0.94, 1], rotate: [-28, 4, 0] }, { duration: 0.6, delay, times: [0, 0.7, 1], ease: 'easeOut' });
          },
          { amount: 0.6 },
        );
        // Footer signature writes itself in once (CSS transitions do the drawing).
        inView('.footer-sign', (element) => { element.classList.add('is-signed'); }, { amount: 0.5 });
      }
    </script>
  </body>
</html>
