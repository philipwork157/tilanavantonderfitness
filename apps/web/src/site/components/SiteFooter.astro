---
import Icon from './Icon';
import { href, navigation, site } from '../config';
// Program names change in the admin, so the footer links to the program page's sections instead.
const programLinks = [
  { label: 'The strength series', path: '/program#strength-series' },
  { label: 'Focus programs', path: '/program#focus-programs' },
  { label: 'Find your fit', path: '/program#quiz' },
  { label: 'One-on-one training', path: '/contact?interest=one-on-one' },
];
const year = 2026;
// Prebuilt pages always carry the badge; <html data-checkout> hides it while checkout is off (base.css).
const withBadge = Astro.locals.checkout || Astro.isPrerendered;
---
<footer class="site-footer">
  <div class="wrap footer-top">
    <div class="footer-brand">
      <a class="wordmark" href={href('/')}>TILANA<span>van Tonder</span></a>
      <p>{site.tagline}</p>
      {withBadge && <div data-checkout-only><span class="pay-badge"><Icon name="lock" /><span>Secure payments by <strong>Paystack</strong></span></span></div>}
    </div>
    <div class="footer-col">
      <h3>Explore</h3>
      <ul>{navigation.map((n) => <li><a href={href(n.path)}>{n.label}</a></li>)}</ul>
    </div>
    <div class="footer-col">
      <h3>Programs</h3>
      <ul>{programLinks.map((l) => <li><a href={href(l.path)}>{l.label}</a></li>)}</ul>
    </div>
    <div class="footer-col">
      <h3>Good to know</h3>
      <ul>
        <li><a href={href('/privacy')}>Privacy policy</a></li>
        <li><a href={href('/refund-policy')}>Refund policy</a></li>
        <li><a href={href('/terms')}>Terms of sale</a></li>
      </ul>
    </div>
  </div>
  <!-- Sign-off: Tilana's name as a handwritten signature that writes itself in
       when the footer scrolls into view (see SiteLayout), with a swash and heart. -->
  <div class="footer-sign" aria-hidden="true">
    <svg viewBox="0 0 1000 380" focusable="false">
      <text class="sign-name" x="500" y="250" text-anchor="middle">Tilana</text>
      <path class="sign-swash" pathLength="1" d="M250 318 C 370 290, 540 334, 690 302 C 760 288, 808 284, 836 292" />
      <path class="sign-heart" pathLength="1" d="M868 288 c -9 -15, -31 -9, -27 6 c 3 12, 19 20, 27 30 c 8 -10, 24 -18, 27 -30 c 4 -15, -18 -21, -27 -6 z" />
    </svg>
    <p class="sign-line">van Tonder <span>·</span> Real · Raw · Honest</p>
  </div>
  <div class="wrap footer-bottom">
    <p>© {year} {site.name} · {site.disclaimer}</p>
    <p class="dev-credit">Developed by <a href={site.developer.url} target="_blank" rel="noopener">{site.developer.name}</a></p>
  </div>
</footer>
