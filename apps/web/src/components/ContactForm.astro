---
import { contactInterestOptions } from '@tilana/contracts/contact';

const contactApiUrl =
  import.meta.env.PUBLIC_CONTACT_API_URL ?? 'http://127.0.0.1:3001/api/contact';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const defaultInterestOption = contactInterestOptions[0];
---

<form class="contact-form" method="post" action={contactApiUrl} data-contact-form data-api-url={contactApiUrl} novalidate>
  <div data-form-content>
    <div class="honeypot" aria-hidden="true">
      <label>
        Leave this field empty
        <input name="website" tabindex="-1" autocomplete="off" maxlength="200" />
      </label>
    </div>

    <div class="form-field" data-field="name">
      <label for="contact-name">Full name</label>
      <input
        id="contact-name"
        name="name"
        autocomplete="name"
        maxlength="100"
        placeholder="Your name"
        aria-describedby="name-error"
      />
      <p id="name-error" class="field-error" data-error-for="name" aria-live="polite"></p>
    </div>

    <div class="form-field" data-field="email">
      <label for="contact-email">Email</label>
      <input
        id="contact-email"
        type="email"
        name="email"
        autocomplete="email"
        maxlength="254"
        placeholder="you@example.com"
        aria-describedby="email-error"
      />
      <p id="email-error" class="field-error" data-error-for="email" aria-live="polite"></p>
    </div>

    <div class="form-field field" data-field="interest">
      <span id="interest-label">What are you interested in?</span>
      <div class="select-wrap" data-interest-select>
        <input type="hidden" name="interest" value="strong" />
        <button
          class="select-trigger"
          type="button"
          aria-labelledby="interest-label interest-value"
          aria-describedby="interest-error"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-controls="interest-options"
        >
          <span id="interest-value" data-select-value>{defaultInterestOption.label}</span>
          <span class="select-caret" aria-hidden="true"></span>
        </button>
        <div id="interest-options" class="select-options" role="listbox" aria-labelledby="interest-label" hidden>
          {contactInterestOptions.map((option, index) => (
            <button
              class="select-option"
              type="button"
              role="option"
              aria-selected={index === 0 ? 'true' : 'false'}
              data-value={option.value}
            >
              {option.label}
            </button>
          ))}
        </div>
      </div>
      <p id="interest-error" class="field-error" data-error-for="interest" aria-live="polite"></p>
    </div>

    <div class="form-field" data-field="message">
      <label for="contact-message">Message</label>
      <textarea
        id="contact-message"
        name="message"
        rows="5"
        maxlength="3000"
        placeholder="How can I help?"
        aria-describedby="message-help message-error"
      ></textarea>
      <small id="message-help" class="field-help">
        Please do not include diagnoses, medical records, injury details, pregnancy complications,
        identity numbers, or other sensitive health information.
      </small>
      <p id="message-error" class="field-error" data-error-for="message" aria-live="polite"></p>
    </div>

    <div class="form-field consent-field" data-field="consent">
      <label class="consent">
        <input type="checkbox" name="consent" aria-describedby="consent-error" />
        <span>
          I have read the <a href="/privacy">privacy policy</a> and agree that these details may be
          used to respond to my enquiry.
        </span>
      </label>
      <p id="consent-error" class="field-error" data-error-for="consent" aria-live="polite"></p>
    </div>

    {turnstileSiteKey && (
      <div class="security-field" data-field="turnstileToken">
        <div
          class="cf-turnstile"
          data-sitekey={turnstileSiteKey}
          data-action="contact"
          data-theme="auto"
        ></div>
        <p class="field-error" data-error-for="turnstileToken" aria-live="polite"></p>
      </div>
    )}

    <button class="button button-primary submit-button" type="submit">
      <span>Send enquiry</span>
      <span class="submit-arrow" aria-hidden="true">→</span>
    </button>
    <p class="form-status" data-form-status role="status" aria-live="polite"></p>
  </div>

  <section class="success-panel" data-success-panel aria-labelledby="success-title" tabindex="-1" hidden>
    <div class="success-mark" aria-hidden="true">
      <span class="success-ring"></span>
      <svg viewBox="0 0 52 52" role="presentation">
        <circle cx="26" cy="26" r="24"></circle>
        <path d="M15 27.5 22.5 35 38 18.5"></path>
      </svg>
      <i class="sparkle sparkle-one"></i>
      <i class="sparkle sparkle-two"></i>
      <i class="sparkle sparkle-three"></i>
    </div>
    <p class="success-eyebrow">Enquiry sent</p>
    <h2 id="success-title">Thank you<span data-success-name></span>.</h2>
    <p>Tilana has received your message and will contact you soon.</p>
    <button class="button success-reset" type="button" data-send-another>Send another enquiry</button>
  </section>
</form>

<script>
  import {
    contactFormRequestSchema,
    contactValidationMessages,
    type ContactFormField,
  } from '@tilana/contracts/contact';

  const selectWrap = document.querySelector<HTMLElement>('[data-interest-select]');
  const selectTrigger = selectWrap?.querySelector<HTMLButtonElement>('.select-trigger');
  const selectMenu = selectWrap?.querySelector<HTMLElement>('.select-options');
  const selectInput = selectWrap?.querySelector<HTMLInputElement>('input[name="interest"]');
  const selectValue = selectWrap?.querySelector<HTMLElement>('[data-select-value]');
  const selectOptions = [...(selectWrap?.querySelectorAll<HTMLButtonElement>('.select-option') ?? [])];
  const contactForm = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const formStatus = contactForm?.querySelector<HTMLElement>('[data-form-status]');
  const submitButton = contactForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const submitButtonLabel = submitButton?.querySelector<HTMLElement>('span');
  const formContent = contactForm?.querySelector<HTMLElement>('[data-form-content]');
  const successPanel = contactForm?.querySelector<HTMLElement>('[data-success-panel]');
  const successName = contactForm?.querySelector<HTMLElement>('[data-success-name]');
  const sendAnotherButton = contactForm?.querySelector<HTMLButtonElement>('[data-send-another]');

  const getPayload = () => {
    if (!contactForm) return null;
    const formData = new FormData(contactForm);
    return {
      name: formData.get('name'),
      email: formData.get('email'),
      interest: formData.get('interest'),
      message: formData.get('message'),
      consent: formData.get('consent') === 'on',
      website: formData.get('website'),
      turnstileToken: String(formData.get('cf-turnstile-response') ?? ''),
    };
  };

  const getFieldControl = (field: ContactFormField) => {
    if (!contactForm) return null;
    if (field === 'interest') return selectTrigger ?? null;
    if (field === 'turnstileToken') return contactForm.querySelector<HTMLElement>('.cf-turnstile');
    const control = contactForm.elements.namedItem(field);
    return control instanceof HTMLElement ? control : null;
  };

  const clearFieldError = (field: ContactFormField) => {
    const fieldWrap = contactForm?.querySelector<HTMLElement>(`[data-field="${field}"]`);
    const errorElement = contactForm?.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
    const control = getFieldControl(field);
    fieldWrap?.classList.remove('has-error');
    control?.removeAttribute('aria-invalid');
    if (errorElement) errorElement.textContent = '';
  };

  const showFieldError = (field: ContactFormField) => {
    const fieldWrap = contactForm?.querySelector<HTMLElement>(`[data-field="${field}"]`);
    const errorElement = contactForm?.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
    const control = getFieldControl(field);
    fieldWrap?.classList.add('has-error');
    control?.setAttribute('aria-invalid', 'true');
    if (errorElement) errorElement.textContent = contactValidationMessages[field];
  };

  const validate = (onlyField?: ContactFormField) => {
    const payload = getPayload();
    if (!payload) return { payload: null, valid: false };

    if (onlyField) clearFieldError(onlyField);
    else (Object.keys(contactValidationMessages) as ContactFormField[]).forEach(clearFieldError);

    const result = contactFormRequestSchema.safeParse(payload);
    const invalidFields = new Set<ContactFormField>();
    if (!result.success) {
      result.error.issues.forEach((issue) => {
        const field = issue.path[0];
        if (typeof field !== 'string' || !(field in contactValidationMessages)) return;
        const contactField = field as ContactFormField;
        if (!onlyField || onlyField === contactField) invalidFields.add(contactField);
      });
    }

    const requiresTurnstile = Boolean(contactForm?.querySelector('.cf-turnstile'));
    if (requiresTurnstile && !payload.turnstileToken && (!onlyField || onlyField === 'turnstileToken')) {
      invalidFields.add('turnstileToken');
    }

    invalidFields.forEach(showFieldError);
    return {
      payload,
      valid: onlyField ? !invalidFields.has(onlyField) : invalidFields.size === 0,
      firstInvalidField: invalidFields.values().next().value as ContactFormField | undefined,
    };
  };

  const showSuccess = (name: string) => {
    if (!formContent || !successPanel) return;
    if (successName) successName.textContent = name.trim() ? `, ${name.trim().split(/\s+/)[0]}` : '';
    formContent.hidden = true;
    successPanel.hidden = false;
    contactForm?.classList.add('is-success');
    window.requestAnimationFrame(() => successPanel.classList.add('is-visible'));
    successPanel.focus({ preventScroll: true });
    successPanel.scrollIntoView({ behavior: 'smooth', block: 'center' });
  };

  const resetSuccess = () => {
    if (!contactForm || !formContent || !successPanel) return;
    contactForm.reset();
    const firstOption = selectOptions[0];
    if (firstOption && selectInput && selectValue) {
      selectInput.value = firstOption.dataset.value ?? '';
      selectValue.textContent = firstOption.textContent?.trim() ?? '';
      selectOptions.forEach((item) => item.setAttribute('aria-selected', String(item === firstOption)));
    }
    (Object.keys(contactValidationMessages) as ContactFormField[]).forEach(clearFieldError);
    if (formStatus) formStatus.textContent = '';
    successPanel.classList.remove('is-visible');
    successPanel.hidden = true;
    formContent.hidden = false;
    contactForm.classList.remove('is-success');
    const turnstile = (window as Window & { turnstile?: { reset: () => void } }).turnstile;
    turnstile?.reset();
    window.requestAnimationFrame(() => {
      const nameInput = contactForm.elements.namedItem('name');
      if (nameInput instanceof HTMLElement) nameInput.focus();
    });
  };

  if (selectWrap && selectTrigger && selectMenu && selectInput && selectValue) {
    const requestedInterest = new URLSearchParams(window.location.search).get('interest');

    const setOpen = (isOpen: boolean) => {
      selectWrap.classList.toggle('is-open', isOpen);
      selectTrigger.setAttribute('aria-expanded', String(isOpen));
      selectMenu.hidden = !isOpen;
    };

    const setSelected = (option: HTMLButtonElement) => {
      selectInput.value = option.dataset.value ?? '';
      selectValue.textContent = option.textContent?.trim() ?? '';
      selectOptions.forEach((item) => item.setAttribute('aria-selected', String(item === option)));
      clearFieldError('interest');
    };

    const requestedOption = selectOptions.find((option) => option.dataset.value === requestedInterest);
    if (requestedOption) setSelected(requestedOption);

    selectTrigger.addEventListener('click', () => setOpen(selectMenu.hasAttribute('hidden')));
    selectTrigger.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setOpen(false);
        return;
      }

      if (!['ArrowDown', 'ArrowUp'].includes(event.key)) return;
      event.preventDefault();
      setOpen(true);
      const selectedIndex = Math.max(0, selectOptions.findIndex((option) => option.getAttribute('aria-selected') === 'true'));
      const focusIndex = event.key === 'ArrowUp' ? Math.max(0, selectedIndex) : selectedIndex;
      selectOptions[focusIndex]?.focus();
    });

    selectOptions.forEach((option, index) => {
      option.addEventListener('click', () => {
        setSelected(option);
        setOpen(false);
        selectTrigger.focus();
      });

      option.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          event.preventDefault();
          setOpen(false);
          selectTrigger.focus();
          return;
        }

        if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const nextIndex = event.key === 'Home'
          ? 0
          : event.key === 'End'
            ? selectOptions.length - 1
            : (index + (event.key === 'ArrowDown' ? 1 : -1) + selectOptions.length) % selectOptions.length;
        selectOptions[nextIndex]?.focus();
      });
    });

    document.addEventListener('pointerdown', (event) => {
      if (event.target instanceof Node && !selectWrap.contains(event.target)) setOpen(false);
    });

    selectWrap.addEventListener('focusout', (event) => {
      if (!(event.relatedTarget instanceof Node) || !selectWrap.contains(event.relatedTarget)) setOpen(false);
    });

    contactForm?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[name], textarea[name]').forEach((control) => {
      const field = control.name as ContactFormField;
      if (!(field in contactValidationMessages)) return;
      const eventName = control.type === 'checkbox' ? 'change' : 'input';
      control.addEventListener(eventName, () => clearFieldError(field));
      control.addEventListener('blur', () => validate(field));
    });

    sendAnotherButton?.addEventListener('click', resetSuccess);

    contactForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!formStatus || !submitButton || !submitButtonLabel) return;

      const validation = validate();
      if (!validation.valid || !validation.payload) {
        getFieldControl(validation.firstInvalidField ?? 'name')?.focus();
        formStatus.textContent = 'Please check the highlighted fields.';
        formStatus.dataset.state = 'error';
        return;
      }

      submitButton.disabled = true;
      submitButton.classList.add('is-loading');
      submitButtonLabel.textContent = 'Sending…';
      formStatus.textContent = '';
      delete formStatus.dataset.state;

      try {
        const response = await fetch(contactForm.dataset.apiUrl ?? contactForm.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(validation.payload),
        });

        if (!response.ok) {
          const error = await response.json().catch(() => null) as { statusMessage?: string; message?: string } | null;
          throw new Error(error?.statusMessage ?? error?.message ?? 'Your enquiry could not be sent. Please try again.');
        }

        showSuccess(String(validation.payload.name));
      } catch (error) {
        formStatus.textContent = error instanceof Error
          ? error.message
          : 'Your enquiry could not be sent. Please try again.';
        formStatus.dataset.state = 'error';
      } finally {
        submitButton.disabled = false;
        submitButton.classList.remove('is-loading');
        submitButtonLabel.textContent = 'Send enquiry';
      }
    });
  }
</script>

<style>
  .contact-form {
    display: grid;
    padding: clamp(1.6rem, 4vw, 2.5rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--sand) 66%, var(--cream));
    box-shadow: var(--shadow-md);
  }

  [data-form-content] {
    display: grid;
    gap: 1.15rem;
  }

  [hidden] {
    display: none !important;
  }

  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .form-status {
    min-height: 0;
    margin: 0;
    color: var(--chocolate);
    font-size: 0.72rem;
  }

  .form-status:empty {
    display: none;
  }

  .form-status[data-state='success'] {
    color: color-mix(in srgb, var(--sage) 35%, var(--ink));
    font-weight: 650;
  }

  .form-status[data-state='error'] {
    color: #9e3f38;
    font-weight: 650;
  }

  .contact-form button[type='submit']:disabled {
    cursor: wait;
    opacity: 0.68;
  }

  .form-field,
  .security-field {
    display: grid;
    gap: 0.5rem;
  }

  label,
  .field {
    display: grid;
    gap: 0.5rem;
    color: var(--ink);
    font-size: 0.74rem;
    font-weight: 650;
  }

  input,
  textarea,
  .select-trigger {
    width: 100%;
    border: 1.5px solid color-mix(in srgb, var(--caramel) 42%, var(--sand));
    border-radius: var(--radius-md);
    color: var(--chocolate);
    background: var(--white);
    outline: none;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 75%);
    transition: border-color 200ms ease, box-shadow 200ms ease, transform 200ms ease;
  }

  input,
  .select-trigger {
    min-height: 3.45rem;
    padding: 0.8rem 1.1rem;
  }

  textarea {
    min-height: 10rem;
    padding: 1rem 1.1rem;
    line-height: 1.6;
    resize: vertical;
  }

  input::placeholder,
  textarea::placeholder {
    color: color-mix(in srgb, var(--chocolate) 56%, transparent);
    font-weight: 500;
  }

  input:focus,
  textarea:focus,
  .select-trigger:focus {
    border-color: var(--caramel);
    box-shadow: 0 0 0 4px rgb(213 162 127 / 20%);
    transform: translateY(-1px);
  }

  .form-field.has-error input,
  .form-field.has-error textarea,
  .form-field.has-error .select-trigger {
    border-color: #ad4b43;
    box-shadow: 0 0 0 4px rgb(173 75 67 / 12%);
  }

  .field-error {
    min-height: 0;
    margin: 0;
    color: #9e3f38;
    font-size: 0.66rem;
    font-weight: 650;
    line-height: 1.45;
  }

  .field-error:empty {
    display: none;
  }

  .field-error:not(:empty) {
    animation: error-in 220ms var(--ease-out) both;
  }

  .select-wrap {
    position: relative;
    display: block;
  }

  .select-trigger {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-right: 3.4rem;
    font: inherit;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
  }

  .select-caret {
    position: absolute;
    top: 50%;
    right: 1.25rem;
    width: 0.62rem;
    height: 0.62rem;
    border-right: 2px solid var(--chocolate);
    border-bottom: 2px solid var(--chocolate);
    pointer-events: none;
    transform: translateY(-70%) rotate(45deg);
    transition: transform 200ms ease;
  }

  .select-wrap.is-open .select-caret {
    transform: translateY(-25%) rotate(225deg);
  }

  .select-options {
    position: absolute;
    z-index: 5;
    top: calc(100% + 0.5rem);
    right: 0;
    left: 0;
    display: grid;
    gap: 0.2rem;
    padding: 0.45rem;
    border: 1px solid color-mix(in srgb, var(--caramel) 42%, var(--sand));
    border-radius: var(--radius-md);
    background: var(--white);
    box-shadow: var(--shadow-md);
    max-height: min(21rem, 52svh);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .select-options[hidden] {
    display: none;
  }

  .select-option {
    width: 100%;
    padding: 0.75rem 0.85rem;
    border: 0;
    border-radius: calc(var(--radius-md) - 0.45rem);
    color: var(--chocolate);
    background: transparent;
    font: inherit;
    font-weight: 550;
    text-align: left;
    cursor: pointer;
    transition: color 180ms ease, background-color 180ms ease, transform 180ms ease;
  }

  .select-option:hover,
  .select-option:focus-visible,
  .select-option[aria-selected='true'] {
    color: var(--ink);
    background: color-mix(in srgb, var(--sage) 70%, var(--white));
  }

  .select-option:hover,
  .select-option:focus-visible {
    transform: translateX(0.2rem);
  }

  .consent {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    color: var(--chocolate);
    font-size: 0.68rem;
    font-weight: 500;
  }

  .consent-field.has-error .consent {
    color: #9e3f38;
  }

  .consent input {
    flex: 0 0 1.1rem;
    width: 1.1rem;
    height: 1.1rem;
    min-height: 1.1rem;
    margin: 0.12rem 0 0;
    padding: 0;
    border-width: 1px;
    border-radius: 0.25rem;
    box-shadow: none;
    accent-color: var(--caramel);
    transform: none;
  }

  .consent a {
    color: var(--caramel);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .field-help {
    color: color-mix(in srgb, var(--chocolate) 78%, transparent);
    font-size: 0.66rem;
    font-weight: 500;
    line-height: 1.5;
    text-align: left;
  }

  button {
    cursor: pointer;
  }

  .submit-button {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
  }

  .submit-arrow {
    font-size: 1.05rem;
    transition: transform 180ms ease;
  }

  .submit-button:hover .submit-arrow {
    transform: translateX(0.25rem);
  }

  .submit-button.is-loading .submit-arrow {
    width: 1rem;
    height: 1rem;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    font-size: 0;
    animation: button-spin 650ms linear infinite;
  }

  .success-panel {
    min-height: 32rem;
    place-items: center;
    align-content: center;
    padding: clamp(1rem, 4vw, 3rem);
    text-align: center;
  }

  .success-panel:not([hidden]) {
    display: grid;
  }

  .success-panel.is-visible > * {
    animation: success-rise 650ms var(--ease-out) both;
  }

  .success-panel.is-visible > :nth-child(2) { animation-delay: 120ms; }
  .success-panel.is-visible > :nth-child(3) { animation-delay: 170ms; }
  .success-panel.is-visible > :nth-child(4) { animation-delay: 220ms; }
  .success-panel.is-visible > :nth-child(5) { animation-delay: 270ms; }

  .success-mark {
    position: relative;
    display: grid;
    width: 7.5rem;
    aspect-ratio: 1;
    place-items: center;
    margin-bottom: 1.5rem;
  }

  .success-mark svg {
    position: relative;
    z-index: 1;
    width: 4.7rem;
    overflow: visible;
    fill: none;
    stroke: var(--ink);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.5;
  }

  .success-mark circle {
    fill: var(--sage);
    stroke: color-mix(in srgb, var(--caramel) 45%, transparent);
  }

  .success-panel.is-visible .success-mark path {
    stroke-dasharray: 32;
    stroke-dashoffset: 32;
    animation: draw-check 650ms 300ms var(--ease-out) forwards;
  }

  .success-ring {
    position: absolute;
    inset: 0;
    border: 1px solid color-mix(in srgb, var(--caramel) 48%, transparent);
    border-radius: 50%;
  }

  .success-panel.is-visible .success-ring {
    animation: success-pulse 900ms 180ms var(--ease-out) both;
  }

  .sparkle {
    position: absolute;
    width: 0.5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--terracotta);
  }

  .sparkle-one { top: 0.4rem; right: 0.65rem; }
  .sparkle-two { bottom: 0.6rem; left: 0.35rem; background: var(--caramel); }
  .sparkle-three { right: -0.1rem; bottom: 1.7rem; width: 0.32rem; background: var(--sage); }

  .success-panel.is-visible .sparkle {
    animation: sparkle-pop 520ms 420ms var(--ease-out) both;
  }

  .success-eyebrow {
    margin: 0 0 0.55rem;
    color: var(--caramel);
