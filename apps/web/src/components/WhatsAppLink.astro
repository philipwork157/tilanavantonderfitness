---
interface Props {
  phone?: string;
  businessName?: string;
  greeting?: string;
  initialMessage?: string;
  placeholder?: string;
}

const {
  phone = '27728803734',
  businessName = 'Tilana van Tonder',
  greeting = "Hi there 👋\n\nHave a question about training or one of my programmes? I'm here to help — send me a WhatsApp!",
  initialMessage = "Hi Tilana, I'd like to find out more about your training options.",
  placeholder = 'Enter your message…',
} = Astro.props;

const internationalPhone = phone.replace(/\D/g, '');
---

<div class="whatsapp-widget" data-whatsapp-widget data-phone={internationalPhone}>
  <section class="whatsapp-panel" id="whatsapp-chat-panel" role="dialog" aria-labelledby="whatsapp-chat-title" hidden data-whatsapp-panel>
    <header>
      <span class="avatar" aria-hidden="true">TVT</span>
      <span class="identity">
        <strong id="whatsapp-chat-title">{businessName}</strong>
        <span><i aria-hidden="true"></i> Online</span>
      </span>
      <button class="close-button" type="button" aria-label="Close WhatsApp chat" data-whatsapp-close>×</button>
    </header>
    <div class="conversation"><p>{greeting}</p></div>
    <form data-whatsapp-form>
      <label class="visually-hidden" for="whatsapp-message">WhatsApp message</label>
      <input id="whatsapp-message" name="message" type="text" value={initialMessage} placeholder={placeholder} autocomplete="off" data-whatsapp-input />
      <button class="send-button" type="submit" aria-label="Send message on WhatsApp">
        <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path fill="currentColor" d="m3.4 20.4 17.45-7.48a1 1 0 0 0 0-1.84L3.4 3.6a.95.95 0 0 0-1.3 1.03l.92 5.6L14 12 3.02 13.77l-.92 5.6a.95.95 0 0 0 1.3 1.03Z" /></svg>
      </button>
    </form>
  </section>

  <button class="whatsapp-launcher" type="button" aria-label="Open WhatsApp chat" aria-controls="whatsapp-chat-panel" aria-expanded="false" data-whatsapp-launcher>
    <svg aria-hidden="true" viewBox="0 0 32 32" focusable="false"><path fill="currentColor" d="M16.04 3A12.93 12.93 0 0 0 5.1 22.82L3.27 29l6.34-1.76A12.96 12.96 0 1 0 16.04 3Zm0 23.74a10.74 10.74 0 0 1-5.48-1.5l-.39-.23-3.76 1.04 1-3.66-.25-.38a10.75 10.75 0 1 1 8.88 4.73Zm5.9-8.04c-.32-.16-1.91-.94-2.2-1.05-.3-.11-.51-.16-.73.16-.21.32-.83 1.05-1.02 1.26-.19.22-.38.24-.7.08-.33-.16-1.37-.5-2.6-1.61a9.73 9.73 0 0 1-1.8-2.24c-.2-.32-.02-.5.14-.66.15-.14.32-.38.49-.57.16-.19.21-.32.32-.54.11-.21.05-.4-.03-.57-.08-.16-.73-1.75-1-2.4-.26-.63-.53-.54-.72-.55h-.62c-.22 0-.57.08-.87.4-.3.33-1.13 1.11-1.13 2.7 0 1.59 1.16 3.12 1.32 3.34.16.21 2.28 3.48 5.52 4.88.77.33 1.37.53 1.84.68.77.24 1.48.21 2.03.13.62-.1 1.91-.79 2.18-1.54.27-.76.27-1.4.19-1.54-.08-.13-.3-.21-.62-.38Z" /></svg>
    <span class="notification-dot" aria-hidden="true"></span>
  </button>
</div>

<script>
  const widget = document.querySelector<HTMLElement>('[data-whatsapp-widget]');
  const panel = widget?.querySelector<HTMLElement>('[data-whatsapp-panel]');
  const launcher = widget?.querySelector<HTMLButtonElement>('[data-whatsapp-launcher]');
  const closeButton = widget?.querySelector<HTMLButtonElement>('[data-whatsapp-close]');
  const form = widget?.querySelector<HTMLFormElement>('[data-whatsapp-form]');
  const input = widget?.querySelector<HTMLInputElement>('[data-whatsapp-input]');

  const setOpen = (isOpen: boolean) => {
    if (!panel || !launcher) return;
    panel.hidden = !isOpen;
    launcher.setAttribute('aria-expanded', String(isOpen));
    launcher.setAttribute('aria-label', isOpen ? 'Close WhatsApp chat' : 'Open WhatsApp chat');
    if (isOpen) window.setTimeout(() => input?.focus(), 0);
    else launcher.focus();
  };

  launcher?.addEventListener('click', () => setOpen(panel?.hasAttribute('hidden') ?? true));
  closeButton?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && panel && !panel.hidden) setOpen(false);
  });
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const message = input?.value.trim();
    const phone = widget?.dataset.phone;
    if (!message || !phone) return input?.focus();
    window.open(`https://wa.me/${phone}?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer');
  });
</script>

<style>
  .whatsapp-widget { position: fixed; z-index: 40; right: max(1.25rem, env(safe-area-inset-right)); bottom: max(1.25rem, env(safe-area-inset-bottom)); }
  .whatsapp-panel { width: min(22.5rem, calc(100vw - 2rem)); overflow: hidden; margin-bottom: 0.85rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); box-shadow: var(--shadow-md); transform-origin: right bottom; animation: panel-in var(--motion-base) var(--ease-out) both; }
  .whatsapp-panel[hidden] { display: none; }
  header { display: flex; min-height: 5.4rem; align-items: center; gap: 0.8rem; padding: 1rem 1.1rem; color: var(--cream); background: var(--chocolate); }
  .avatar { display: grid; width: 3rem; height: 3rem; flex: 0 0 auto; place-items: center; border: 2px solid color-mix(in srgb, var(--cream) 82%, transparent); border-radius: 50%; color: var(--chocolate); background: var(--terracotta); box-shadow: 0 0 0 3px color-mix(in srgb, var(--cream) 10%, transparent); font-family: var(--font-heading); font-size: 0.78rem; font-weight: 700; }
  .identity { display: grid; gap: 0.15rem; line-height: 1.25; }
  .identity strong { font-family: var(--font-heading); font-size: 1.05rem; font-weight: 600; letter-spacing: 0.01em; }
  .identity > span { display: flex; align-items: center; gap: 0.35rem; color: color-mix(in srgb, var(--cream) 76%, transparent); font-size: 0.74rem; }
  .identity i { width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--sage); box-shadow: 0 0 0 2px color-mix(in srgb, var(--sage) 22%, transparent); }
  button { border: 0; cursor: pointer; }
  .close-button { margin: 0 0 auto auto; padding: 0.1rem 0.25rem; color: color-mix(in srgb, var(--cream) 68%, transparent); background: transparent; font-size: 1.5rem; line-height: 1; }
  .close-button:hover { color: var(--cream); }
  .conversation { min-height: 11.5rem; padding: 2.4rem 1rem 1.3rem; background-color: color-mix(in srgb, var(--cream) 72%, var(--white)); background-image: radial-gradient(circle at 15% 25%, color-mix(in srgb, var(--caramel) 12%, transparent) 0 1px, transparent 1.5px), radial-gradient(circle at 70% 65%, color-mix(in srgb, var(--caramel) 10%, transparent) 0 1.5px, transparent 2px); background-size: 2rem 2rem, 2.8rem 2.8rem; }
  .conversation p { position: relative; max-width: 16.5rem; margin: 0; padding: 0.9rem 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); color: var(--color-text); background: var(--color-surface); box-shadow: var(--shadow-sm); font-size: 0.9rem; line-height: 1.45; white-space: pre-line; }
  form { display: flex; min-height: 3.7rem; align-items: center; gap: 0.7rem; padding: 0.55rem 0.75rem 0.55rem 1rem; border-top: 1px solid var(--color-border); background: var(--color-surface); }
  input { width: 100%; min-width: 0; border: 0; outline: 0; color: var(--color-text); background: transparent; font-size: 0.86rem; }
  input::placeholder { color: color-mix(in srgb, var(--color-text-muted) 62%, transparent); }
  .send-button { display: grid; width: 2.5rem; height: 2.5rem; flex: 0 0 auto; place-items: center; border-radius: 50%; color: var(--color-on-primary); background: var(--terracotta); transition: background-color var(--motion-fast) ease, transform var(--motion-fast) ease; }
  .send-button:hover { background: var(--caramel); transform: scale(1.05); }
  .send-button svg { width: 1.2rem; height: 1.2rem; transform: translateX(0.05rem); }
  .whatsapp-launcher { position: relative; display: grid; width: 3.9rem; height: 3.9rem; margin-left: auto; place-items: center; border: 2px solid color-mix(in srgb, var(--white) 72%, transparent); border-radius: 50%; color: var(--ink); background: var(--sage); box-shadow: var(--shadow-md); transition: background-color var(--motion-base) ease, box-shadow var(--motion-base) ease, transform var(--motion-base) ease; }
  .whatsapp-launcher:hover { background: color-mix(in srgb, var(--sage) 82%, var(--caramel)); box-shadow: var(--shadow-hover); transform: translateY(-3px); }
  .whatsapp-launcher svg { width: 2rem; height: 2rem; }
  .notification-dot { position: absolute; top: 0.05rem; right: 0.05rem; width: 0.72rem; height: 0.72rem; border: 2px solid var(--cream); border-radius: 50%; background: var(--terracotta); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @keyframes panel-in { from { opacity: 0; transform: translateY(0.75rem) scale(0.97); } }
  @media (max-width: 30rem) { .whatsapp-widget { right: max(1rem, env(safe-area-inset-right)); bottom: max(1rem, env(safe-area-inset-bottom)); } .whatsapp-panel { width: calc(100vw - 2rem); } .conversation { min-height: 10rem; } }
  @media (prefers-reduced-motion: reduce) { .whatsapp-panel { animation: none; } .whatsapp-launcher, .send-button { transition: none; } }
</style>
