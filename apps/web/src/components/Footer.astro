---
import BrandMark from '@tilana/ui-astro/BrandMark.astro';
import { site } from '../data/site';
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <BrandMark name={site.name} variant="footer" />
      <p>Move better. Feel stronger. Live healthier.</p>
    </div>
    <nav aria-label="Footer navigation">
      {site.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
  <div class="container footer-bottom">
    <div class="footer-left">
      <span>© {new Date().getFullYear()} {site.name}</span>
      <span class="dev-credit">Developed by <a href="https://www.philipvtonder.co.za/" target="_blank" rel="noopener">Philip van Tonder</a></span>
    </div>
    <div class="footer-meta">
      <a class="privacy-link" href="/privacy">
        <span>Privacy policy</span>
        <span class="privacy-arrow" aria-hidden="true">↗</span>
      </a>
      <span class="footer-note">General education and lived experience—not medical care.</span>
    </div>
  </div>
</footer>
<style>
  .site-footer { padding: 4.5rem 0 1.5rem; color: var(--cream); background: var(--ink); }
  .footer-grid { display: flex; justify-content: space-between; gap: 3rem; }
  p { margin: 0.7rem 0 0; color: var(--sand); font-size: 0.85rem; }
  nav { display: grid; gap: 0.65rem 2.5rem; grid-template-columns: repeat(2, auto); }
  nav a { color: var(--sand); font-size: 0.82rem; }
  nav a:hover { color: var(--terracotta); }
  .footer-bottom { display: flex; justify-content: space-between; gap: 1.5rem; margin-top: 3rem; padding-top: 1.25rem; border-top: 1px solid color-mix(in srgb, var(--cream) 20%, transparent); color: color-mix(in srgb, var(--cream) 82%, transparent); font-size: 0.68rem; }
  .footer-meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 0.9rem 1.5rem; }
  .privacy-link {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    overflow: hidden;
    padding: 0.58rem 0.9rem;
    border: 1px solid rgb(217 162 126 / 70%);
    border-radius: 999px;
    color: var(--cream);
    font-size: 0.72rem;
    font-weight: 750;
    line-height: 1;
    text-decoration: none;
    transition: color 240ms ease, border-color 240ms ease, box-shadow 240ms ease, transform 240ms ease;
  }
  .privacy-link::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: var(--terracotta);
    content: '';
    transform: translateX(-102%);
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .privacy-arrow { font-size: 0.85rem; transition: transform 240ms ease; }
  .privacy-link:hover {
    border-color: var(--terracotta);
    color: var(--ink);
    box-shadow: 0 0.65rem 1.5rem rgb(0 0 0 / 18%);
    transform: translateY(-2px);
  }
  .privacy-link:hover::before { transform: translateX(0); }
  .privacy-link:hover .privacy-arrow { transform: translate(0.12rem, -0.12rem); }
  .privacy-link:focus-visible { outline: 2px solid var(--terracotta); outline-offset: 4px; }
  .footer-note { line-height: 1.5; }
  .footer-left { display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem 0.85rem; }
  .dev-credit a { position: relative; color: color-mix(in srgb, var(--cream) 96%, transparent); font-weight: 700; text-decoration: none; white-space: nowrap; transition: color var(--motion-fast) ease; }
  .dev-credit a::after { position: absolute; right: 0; bottom: -2px; left: 0; height: 1.5px; background: var(--terracotta); content: ''; transform: scaleX(0); transform-origin: left; transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1); }
  .dev-credit a:hover { color: var(--cream); }
  .dev-credit a:hover::after { transform: scaleX(1); }
  .dev-credit a:focus-visible { outline: 2px solid var(--terracotta); outline-offset: 3px; border-radius: 2px; }
  @media (prefers-reduced-motion: reduce) {
    .privacy-link, .privacy-link::before, .privacy-arrow, .dev-credit a, .dev-credit a::after { transition: none; }
  }
  @media (max-width: 42rem) { .footer-grid, .footer-bottom { align-items: flex-start; flex-direction: column; } }
  @media (max-width: 42rem) { .footer-meta { justify-content: flex-start; } }
</style>
