---
const newsletterApiUrl =
  import.meta.env.PUBLIC_NEWSLETTER_API_URL ?? 'http://127.0.0.1:3001/api/newsletter/subscribe';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---

<section class="newsletter" aria-labelledby="newsletter-title">
  <div class="container newsletter-inner">
    <div class="newsletter-copy">
      <p class="eyebrow">A thoughtful note, occasionally</p>
      <h2 id="newsletter-title">Stronger, <span class="script">one step at a time.</span></h2>
      <p>Practical training guidance, programme updates, and realistic healthy habits—sent without the noise.</p>
    </div>

    <div class="newsletter-shell" data-newsletter-shell>
      <form data-newsletter-form data-api-url={newsletterApiUrl} novalidate>
        <div class="honeypot" aria-hidden="true">
          <label>Leave this field empty <input name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <div class="email-row" data-field="email">
          <label class="visually-hidden" for="newsletter-email">Email address</label>
          <input id="newsletter-email" type="email" name="email" autocomplete="email" maxlength="254" placeholder="Your email address" aria-describedby="newsletter-email-error" />
          <button type="submit" data-submit>
            <span class="btn-label">Join the newsletter</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
            <span class="btn-spinner" aria-hidden="true"></span>
          </button>
        </div>
        <p id="newsletter-email-error" class="field-error" data-error-for="email" aria-live="polite"></p>
        <label class="consent" data-field="consent">
          <input type="checkbox" name="consent" aria-describedby="newsletter-consent-error" />
          <span>I agree to receive occasional emails from Tilana. I can unsubscribe at any time. <a href="/privacy">Privacy policy</a>.</span>
        </label>
        <p id="newsletter-consent-error" class="field-error" data-error-for="consent" aria-live="polite"></p>
        {turnstileSiteKey && (
          <div class="security" data-field="turnstileToken">
            <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="newsletter" data-theme="auto"></div>
            <p class="field-error" data-error-for="turnstileToken" aria-live="polite"></p>
          </div>
        )}
        <p class="form-status" data-newsletter-status role="status" aria-live="polite"></p>
      </form>

      <div class="newsletter-success" data-newsletter-success hidden>
        <span class="success-glow" aria-hidden="true"></span>
        <span class="success-spark success-spark--1" aria-hidden="true"></span>
        <span class="success-spark success-spark--2" aria-hidden="true"></span>
        <span class="success-spark success-spark--3" aria-hidden="true"></span>
        <span class="success-spark success-spark--4" aria-hidden="true"></span>
        <div class="success-badge" aria-hidden="true">
          <svg viewBox="0 0 52 52" class="success-check">
            <circle class="success-check__circle" cx="26" cy="26" r="23" />
            <path class="success-check__mark" d="M15 27 l7.5 7.5 L38 19" />
          </svg>
        </div>
        <h3>You're almost in.</h3>
        <p>We've sent a confirmation link to <strong data-success-email>your inbox</strong>. Tap it once and you're subscribed.</p>
        <p class="success-hint">Nothing yet? Peek in your spam or promotions folder.</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { newsletterValidationMessages, type NewsletterFormField } from '@tilana/contracts/newsletter.messages';

  const shell = document.querySelector<HTMLElement>('[data-newsletter-shell]');
  const form = document.querySelector<HTMLFormElement>('[data-newsletter-form]');
  const status = form?.querySelector<HTMLElement>('[data-newsletter-status]');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const successPanel = shell?.querySelector<HTMLElement>('[data-newsletter-success]');
  const successEmail = successPanel?.querySelector<HTMLElement>('[data-success-email]');

  function setStatus(message: string, tone: 'idle' | 'error') {
    if (!status) return;
    status.textContent = message;
    status.classList.toggle('is-error', tone === 'error');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !status || !button || !shell || !successPanel) return;

    const data = new FormData(form);
    const email = String(data.get('email') ?? '').trim();
    const payload = {
      email: data.get('email'),
      consent: data.get('consent') === 'on',
      source: 'website-footer',
      website: data.get('website'),
      turnstileToken: String(data.get('cf-turnstile-response') ?? ''),
    };
    form.querySelectorAll<HTMLElement>('[data-error-for]').forEach((item) => { item.textContent = ''; });
    form.querySelectorAll<HTMLElement>('[aria-invalid="true"]').forEach((item) => item.removeAttribute('aria-invalid'));

    // Lightweight client-side checks (the server re-validates with the full schema).
    const emailValue = email;
    const emailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailValue) && emailValue.length <= 254;
    const missingTurnstile = Boolean(form.querySelector('.cf-turnstile')) && !payload.turnstileToken;
    const fields = new Set<NewsletterFormField>();
    if (!emailValid) fields.add('email');
    if (payload.consent !== true) fields.add('consent');
    if (missingTurnstile) fields.add('turnstileToken');
    if (fields.size) {
      fields.forEach((field) => {
        const error = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
        const control = form.elements.namedItem(field);
        if (error) error.textContent = newsletterValidationMessages[field];
        if (control instanceof HTMLElement) control.setAttribute('aria-invalid', 'true');
      });
      return;
    }

    button.disabled = true;
    button.classList.add('is-loading');
    setStatus('', 'idle');
    try {
      const response = await fetch(form.dataset.apiUrl ?? '', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: emailValue,
          consent: true,
          source: 'website-footer',
          website: payload.website,
          turnstileToken: payload.turnstileToken,
        }),
      });
      if (!response.ok) throw new Error('Subscription failed');
      form.reset();
      if (successEmail && email) successEmail.textContent = email;
      shell.style.minHeight = `${shell.offsetHeight}px`;
      form.hidden = true;
      successPanel.hidden = false;
      // Restart the entrance animation reliably.
      successPanel.classList.remove('is-in');
      void successPanel.offsetWidth;
      successPanel.classList.add('is-in');
      successPanel.setAttribute('role', 'status');
    } catch {
      setStatus('We could not start your subscription. Please try again shortly.', 'error');
    } finally {
      button.disabled = false;
      button.classList.remove('is-loading');
      const turnstile = (window as Window & { turnstile?: { reset: () => void } }).turnstile;
      turnstile?.reset();
    }
  });
</script>

<style>
  .newsletter { padding-block: clamp(3.5rem, 6vw, 5rem); border-top: 1px solid var(--color-border); background: color-mix(in srgb, var(--sage) 72%, var(--cream)); }
  .newsletter-inner { display: grid; align-items: center; gap: clamp(2rem, 6vw, 5rem); grid-template-columns: minmax(0, 0.9fr) minmax(20rem, 1.1fr); }
  .newsletter-copy h2 { max-width: 34rem; margin: 0; color: var(--ink); font-family: var(--font-heading); font-size: clamp(2rem, 4vw, 3.4rem); line-height: 1.08; }
  .newsletter-copy > p:last-child { max-width: 36rem; margin: 1rem 0 0; color: var(--chocolate); }

  .newsletter-shell { position: relative; }
  form { position: relative; padding: clamp(1.25rem, 3vw, 1.8rem); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: color-mix(in srgb, var(--white) 82%, var(--cream)); box-shadow: var(--shadow-sm); }
  .email-row { display: flex; gap: 0.65rem; }
  input[type='email'] { width: 100%; min-width: 0; min-height: 3.25rem; padding: 0.8rem 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-pill); color: var(--ink); background: var(--white); }
  input[type='email']:focus { border-color: var(--caramel); outline: 2px solid color-mix(in srgb, var(--caramel) 24%, transparent); }

  button { position: relative; display: inline-flex; min-height: 3.25rem; flex: 0 0 auto; align-items: center; gap: 0.55rem; padding: 0.8rem 1.25rem; border: 0; border-radius: var(--radius-pill); color: var(--color-on-primary); background: var(--terracotta); font-weight: 700; cursor: pointer; transition: background-color var(--motion-fast) ease, transform var(--motion-fast) ease; }
  button:hover { background: var(--caramel); transform: translateY(-2px); }
  button:disabled { cursor: wait; }
  button.is-loading { transform: none; opacity: 0.9; }
  button.is-loading .btn-label { opacity: 0.75; }
  button.is-loading .btn-arrow { opacity: 0; }
  .btn-spinner { position: absolute; right: 1.15rem; width: 1.05rem; height: 1.05rem; border-radius: 50%; border: 2px solid color-mix(in srgb, var(--color-on-primary) 45%, transparent); border-top-color: var(--color-on-primary); opacity: 0; }
  button.is-loading .btn-spinner { opacity: 1; animation: nl-spin 0.7s linear infinite; }

  .consent { display: flex; align-items: flex-start; gap: 0.65rem; margin-top: 1rem; color: var(--chocolate); font-size: 0.72rem; line-height: 1.55; }
  .consent input { margin-top: 0.2rem; accent-color: var(--caramel); }
  .consent a { font-weight: 700; text-decoration: underline; text-underline-offset: 0.15em; }
  .field-error { min-height: 1.2rem; margin: 0.35rem 0 0; color: #a23a32; font-size: 0.7rem; }
  .form-status { min-height: 0; margin: 0; color: #a23a32; font-size: 0.7rem; }
  .form-status.is-error { min-height: 1.2rem; margin: 0.6rem 0 0; }
  .security { margin-top: 0.8rem; }
  .honeypot, .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Success card */
  .newsletter-success { position: relative; overflow: hidden; display: grid; justify-items: center; gap: 0.5rem; padding: clamp(1.8rem, 4vw, 2.6rem) clamp(1.25rem, 3vw, 1.8rem); border: 1px solid color-mix(in srgb, var(--caramel) 35%, var(--color-border)); border-radius: var(--radius-lg); background: linear-gradient(160deg, color-mix(in srgb, var(--white) 90%, var(--cream)), color-mix(in srgb, var(--sage) 40%, var(--cream))); box-shadow: var(--shadow-md); text-align: center; }
  .newsletter-success[hidden] { display: none; }
  .newsletter-success.is-in { animation: nl-card-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) both; }

  .success-glow { position: absolute; top: -30%; left: 50%; width: 16rem; height: 16rem; transform: translateX(-50%) scale(0.4); border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--caramel) 45%, transparent), transparent 65%); opacity: 0; pointer-events: none; }
  .is-in .success-glow { animation: nl-glow 0.9s ease-out 0.1s both; }

  .success-badge { display: grid; place-items: center; width: 4.25rem; height: 4.25rem; border-radius: 50%; background: color-mix(in srgb, var(--white) 70%, var(--sage)); box-shadow: 0 8px 24px color-mix(in srgb, var(--caramel) 30%, transparent); }
  .is-in .success-badge { animation: nl-badge-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.08s both; }
  .success-check { width: 2.6rem; height: 2.6rem; }
  .success-check__circle { fill: none; stroke: var(--caramel); stroke-width: 3; stroke-dasharray: 150; stroke-dashoffset: 150; }
  .success-check__mark { fill: none; stroke: var(--terracotta); stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 48; stroke-dashoffset: 48; }
  .is-in .success-check__circle { animation: nl-draw 0.5s ease-out 0.15s forwards; }
  .is-in .success-check__mark { animation: nl-draw 0.35s ease-out 0.5s forwards; }

  .newsletter-success h3 { margin: 0.4rem 0 0; color: var(--ink); font-family: var(--font-heading); font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.1; }
  .newsletter-success > p { max-width: 26rem; margin: 0; color: var(--chocolate); font-size: 0.86rem; line-height: 1.6; }
  .newsletter-success [data-success-email] { color: var(--ink); font-weight: 700; }
  .success-hint { margin-top: 0.15rem !important; color: color-mix(in srgb, var(--chocolate) 70%, transparent) !important; font-size: 0.72rem !important; }
  .is-in h3, .is-in > p { animation: nl-rise 0.5s ease-out both; }
  .is-in h3 { animation-delay: 0.32s; }
  .is-in > p:not(.success-hint) { animation-delay: 0.4s; }
  .is-in .success-hint { animation-delay: 0.48s; }

  .success-spark { position: absolute; width: 0.5rem; height: 0.5rem; border-radius: 50%; opacity: 0; pointer-events: none; }
  .success-spark--1 { top: 22%; left: 24%; background: var(--terracotta); }
  .success-spark--2 { top: 30%; right: 22%; background: var(--caramel); }
  .success-spark--3 { top: 58%; left: 18%; width: 0.35rem; height: 0.35rem; background: var(--caramel); }
  .success-spark--4 { top: 52%; right: 20%; width: 0.4rem; height: 0.4rem; background: var(--terracotta); }
  .is-in .success-spark { animation: nl-spark 0.8s ease-out 0.45s both; }

  @keyframes nl-spin { to { transform: rotate(360deg); } }
  @keyframes nl-card-in { from { opacity: 0; transform: translateY(14px) scale(0.98); } to { opacity: 1; transform: none; } }
  @keyframes nl-badge-pop { from { opacity: 0; transform: scale(0.4); } to { opacity: 1; transform: scale(1); } }
  @keyframes nl-draw { to { stroke-dashoffset: 0; } }
  @keyframes nl-rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @keyframes nl-glow { 0% { opacity: 0; transform: translateX(-50%) scale(0.4); } 40% { opacity: 0.9; } 100% { opacity: 0; transform: translateX(-50%) scale(1.15); } }
  @keyframes nl-spark { 0% { opacity: 0; transform: scale(0) translateY(0); } 45% { opacity: 1; } 100% { opacity: 0; transform: scale(1) translateY(-14px); } }

  @media (max-width: 52rem) { .newsletter-inner { grid-template-columns: 1fr; } }
  @media (max-width: 34rem) { .email-row { flex-direction: column; } button { justify-content: center; width: 100%; } .btn-spinner { right: 1.5rem; } }
  @media (prefers-reduced-motion: reduce) {
    button { transition: none; }
    button.is-loading .btn-spinner { animation-duration: 1.4s; }
    .newsletter-success.is-in, .is-in .success-glow, .is-in .success-badge, .is-in .success-check__circle, .is-in .success-check__mark, .is-in h3, .is-in > p, .is-in .success-spark { animation: none; }
    .success-check__circle, .success-check__mark { stroke-dashoffset: 0; }
    .newsletter-success h3, .newsletter-success > p, .success-badge { opacity: 1; }
  }
</style>
