---
import LegalPage from '@web/site/components/LegalPage.astro';
import { refundSections, refundSummary } from '@web/site/legal';
import { orderContactHref } from '@web/site/config';
---
<LegalPage pageTitle="Refund & Cancellation Policy" description="Refund and cancellation policy for once-off digital program purchases." summary={refundSummary} sections={refundSections}>
  <li data-reveal>
    <span class="n">{String(refundSections.length + 1).padStart(2, '0')}</span>
    <div>
      <h2>Start a request</h2>
      <p>Send a message through the <a href={orderContactHref('refund')}>contact page</a> and keep your order or Paystack reference available so the payment can be located safely.</p>
    </div>
  </li>
</LegalPage>
