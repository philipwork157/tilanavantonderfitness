---
import SiteLayout from '@web/site/layouts/SiteLayout.astro';
import PageHero from '@web/site/components/PageHero.astro';
import BlogExplorer from '@web/site/components/BlogExplorer';
import { blogCategories } from '@web/site/data';
import { getPosts, toCard } from '@web/site/blog';
import { setBlogCacheHeaders } from '@web/utils/blog-http';

// Rendered on request so newly published posts appear without a rebuild.
export const prerender = false;
const cards = (await getPosts()).map(toCard);
setBlogCacheHeaders(Astro.response.headers);
---
<SiteLayout title="Strength & Healthy Habits Blog" current="blog" description="Simple, encouraging writing about strength, movement, and sustainable progress - without miracle claims.">
  <PageHero
    eyebrow="The blog"
    lines={['Useful notes', 'for *real life.*']}
    intro="Simple, encouraging writing about strength, movement, and sustainable progress - without miracle claims."
  />
  <section class="section wrap">
    <BlogExplorer client:load posts={cards} categories={[...blogCategories]} />
  </section>
</SiteLayout>
