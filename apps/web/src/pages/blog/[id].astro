---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
export async function getStaticPaths() { const posts = await getCollection('blog', ({ data }) => !data.draft); return posts.map((post) => ({ params: { id: post.id }, props: { post } })); }
const { post } = Astro.props;
const { Content } = await render(post);
const featuredImage = post.data.image ?? (post.id === 'welcome-a-little-about-me' ? '/tilana-blog-welcome.jpg' : undefined);
const featuredImageWidth = post.data.imageWidth ?? 944;
const featuredImageHeight = post.data.imageHeight ?? 1104;
const formattedPublishedAt = post.data.publishedAt.toLocaleDateString('en-ZA', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const readingMinutes = Number.parseInt(post.data.readingTime, 10);
const canonical = new URL(`/blog/${post.id}`, Astro.site).href;
const pageId = `${canonical}#webpage`;
const websiteId = new URL('/#website', Astro.site).href;
const personId = new URL('/#person', Astro.site).href;
const articleImage = featuredImage ? new URL(featuredImage, Astro.site).href : null;
const webPageSchema = {
  '@type': 'WebPage',
  '@id': pageId,
  url: canonical,
  name: `${post.data.title} | Tilana van Tonder`,
  description: post.data.description,
  isPartOf: { '@id': websiteId },
  about: { '@id': personId },
};
const articleSchema = {
  '@type': 'BlogPosting',
  '@id': `${canonical}#article`,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: post.data.publishedAt.toISOString(),
  mainEntityOfPage: { '@id': pageId },
  isPartOf: { '@id': websiteId },
  author: { '@id': personId },
  publisher: { '@id': personId },
  ...(articleImage ? { image: articleImage } : {}),
  ...(Number.isFinite(readingMinutes) ? { timeRequired: `PT${readingMinutes}M` } : {}),
  inLanguage: 'en-ZA',
};
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical },
  ],
};
---
<BaseLayout title={post.data.title} description={post.data.description} image={featuredImage ?? null} imageAlt={post.data.imageAlt} imageWidth={featuredImage ? featuredImageWidth : undefined} imageHeight={featuredImage ? featuredImageHeight : undefined} imageType={featuredImage ? 'image/jpeg' : undefined} pageType="article" publishedAt={post.data.publishedAt} structuredData={[webPageSchema, articleSchema, breadcrumbSchema]}>
  <div class="reading-progress" data-reading-progress role="progressbar" aria-label="Article reading progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></div>
  <article data-blog-article><header><div class:list={['container', { 'header-grid': featuredImage }]}><div class="header-copy"><a href="/blog">← Back to blog</a><p class="article-eyebrow">A personal story</p><h1>{post.data.title}</h1><dl class="article-meta" aria-label="Article details"><div><dt>Published</dt><dd><time datetime={post.data.publishedAt.toISOString()}>{formattedPublishedAt}</time></dd></div><div><dt>Reading time</dt><dd>{post.data.readingTime}</dd></div><div><dt>Filed under</dt><dd>{post.data.category}</dd></div></dl></div>{featuredImage && <figure><img src={featuredImage} alt={post.data.imageAlt ?? 'Tilana van Tonder smiling in a white shirt'} width={featuredImageWidth} height={featuredImageHeight} loading="eager" decoding="async" fetchpriority="high" /></figure>}</div></header><div class="article-body"><div class="reading-card"><div class="reading-label"><span aria-hidden="true">♡</span> A personal note from Tilana</div><div class="prose"><Content /></div><aside><strong>Please note</strong><p>This article is general education based on lived experience. It does not diagnose, treat, or replace advice from an appropriately qualified healthcare professional.</p></aside></div></div></article>
</BaseLayout>
<style>
  .reading-progress { position: fixed; z-index: 50; top: 0; right: 0; left: 0; height: 4px; overflow: hidden; background: color-mix(in srgb, var(--sage) 38%, transparent); pointer-events: none; }
  .reading-progress span { display: block; width: 100%; height: 100%; background: linear-gradient(90deg, var(--terracotta), var(--caramel), var(--sage)); box-shadow: 0 0 12px color-mix(in srgb, var(--caramel) 55%, transparent); transform: scaleX(0); transform-origin: left center; transition: transform 90ms linear; }
  header { min-height: calc(100svh - 5.5rem); display: grid; align-items: center; padding: clamp(3.5rem, 8vw, 7rem) 0; background: color-mix(in srgb, var(--sand) 58%, var(--cream)); }
  header a { color: var(--caramel); font-size: 0.75rem; font-weight: 650; }
  .article-eyebrow { margin: 3rem 0 0.8rem; color: var(--caramel); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  header h1 { max-width: 11ch; margin: 0; color: var(--ink); font-family: var(--font-heading); font-size: clamp(3.2rem, 6vw, 6.3rem); font-weight: 600; letter-spacing: -0.04em; line-height: 0.98; }
  .header-grid { display: grid; width: 100%; max-width: none; align-items: center; gap: clamp(3rem, 7vw, 7rem); padding-inline: clamp(1.25rem, 6vw, 7rem); grid-template-columns: minmax(0, 1fr) minmax(18rem, 29rem); }
  .header-copy { min-width: 0; }
  figure { width: 100%; max-width: 29rem; margin: 0; overflow: hidden; justify-self: end; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--sand); box-shadow: var(--shadow-md); }
  figure img { width: 100%; height: auto; }
  .article-meta { display: grid; max-width: 43rem; margin: 2.25rem 0 0; padding: 0; overflow: hidden; border: 1px solid color-mix(in srgb, var(--caramel) 25%, transparent); border-radius: var(--radius-md); background: color-mix(in srgb, var(--white) 38%, transparent); grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .article-meta > div { display: grid; min-width: 0; gap: 0.28rem; padding: 0.9rem 1rem; }
  .article-meta > div + div { border-left: 1px solid color-mix(in srgb, var(--caramel) 22%, transparent); }
  .article-meta :is(dt, dd) { margin: 0; }
  .article-meta dt { color: var(--caramel); font-size: 0.56rem; font-weight: 750; letter-spacing: 0.1em; text-transform: uppercase; }
  .article-meta dd { overflow-wrap: anywhere; color: var(--ink); font-size: 0.72rem; font-weight: 650; line-height: 1.4; }
  .article-body { width: 100%; padding: clamp(1rem, 3vw, 3rem); background: var(--cream); }
  .reading-card { position: relative; width: 100%; overflow: hidden; padding: clamp(2rem, 6vw, 6rem); border: 1px solid color-mix(in srgb, var(--caramel) 24%, transparent); border-radius: var(--radius-lg); background: color-mix(in srgb, var(--white) 55%, var(--cream)); box-shadow: var(--shadow-sm); }
  .reading-card::before { position: absolute; top: 0; right: 0; left: 0; height: 5px; background: linear-gradient(90deg, var(--terracotta), var(--sage), var(--caramel)); content: ''; }
  .reading-label { display: flex; width: 100%; max-width: 46rem; align-items: center; gap: 0.55rem; margin: 0 auto clamp(2rem, 5vw, 3.5rem); color: var(--caramel); font-size: 0.68rem; font-weight: 750; letter-spacing: 0.12em; text-transform: uppercase; }
  .reading-label span { font-size: 1.15rem; line-height: 1; }
  :global(.reading-card .prose) { max-width: 46rem; margin-inline: auto; }
  :global(.reading-card .prose > p) { margin: 0 0 1.65rem; font-size: clamp(1rem, 1.4vw, 1.08rem); line-height: 1.95; }
  :global(.reading-card .article-intro) { display: grid; align-items: start; gap: clamp(0.8rem, 2vw, 1.25rem); color: var(--ink); font-family: var(--font-heading); font-size: clamp(1.3rem, 2.2vw, 1.65rem); line-height: 1.55; grid-template-columns: auto minmax(0, 1fr); }
  :global(.reading-card .drop-cap) { display: block; margin-top: -0.08em; color: var(--caramel); font-family: var(--font-heading); font-size: 4.25em; line-height: 0.8; }
  :global(.reading-card .prose strong) { color: var(--ink); font-weight: 700; }
  :global(.reading-card .prose > p:last-child) { margin-bottom: 0; }
  :global(.article-closing) { position: relative; margin-top: clamp(2.5rem, 6vw, 4.5rem); overflow: hidden; padding: clamp(1.6rem, 4vw, 2.5rem); border: 1px solid color-mix(in srgb, var(--caramel) 24%, transparent); border-radius: var(--radius-lg); background: color-mix(in srgb, var(--sage) 58%, var(--cream)); }
  :global(.article-closing::after) { position: absolute; top: -3.5rem; right: -2.5rem; width: 9rem; aspect-ratio: 1; border-radius: 50%; background: color-mix(in srgb, var(--terracotta) 18%, transparent); content: ''; }
  :global(.article-closing > p) { position: relative; z-index: 1; max-width: 25rem; margin: 0 0 2rem; color: var(--ink); font-family: var(--font-heading); font-size: clamp(1.35rem, 2.5vw, 1.8rem); line-height: 1.35; }
  :global(.article-signature) { position: relative; z-index: 1; display: grid; width: fit-content; gap: 0.15rem; padding-top: 1.2rem; border-top: 1px solid color-mix(in srgb, var(--caramel) 35%, transparent); }
  :global(.article-signature span) { color: var(--chocolate); font-size: 0.78rem; font-style: italic; }
  :global(.article-signature strong) { color: var(--caramel); font-family: var(--font-script); font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 400; line-height: 1; }
  :global(.bible-verse) { position: relative; display: grid; justify-items: center; gap: 0.7rem; margin: clamp(3rem, 7vw, 5rem) 0 0; padding: clamp(2rem, 5vw, 3.5rem); border: 0; border-radius: var(--radius-lg); color: var(--color-on-primary); background: var(--terracotta); text-align: center; box-shadow: var(--shadow-sm); }
  :global(.bible-verse > span) { color: var(--sage); font-size: 1.2rem; }
  :global(.bible-verse p) { max-width: 28rem; margin: 0; color: inherit; font-family: var(--font-heading); font-size: clamp(1.45rem, 3vw, 2.15rem); line-height: 1.35; }
  :global(.bible-verse cite) { color: color-mix(in srgb, var(--color-on-primary) 78%, transparent); font-size: 0.68rem; font-style: normal; font-weight: 750; letter-spacing: 0.12em; text-transform: uppercase; }
  aside { max-width: 46rem; margin: clamp(3rem, 6vw, 5rem) auto 0; padding: 1.25rem 1.4rem; border-radius: var(--radius-md); background: var(--sage); }
  aside strong { color: var(--ink); font-size: 0.7rem; text-transform: uppercase; }
  aside p { margin: 0.5rem 0 0; color: var(--chocolate); font-size: 0.7rem; line-height: 1.6; }
  @media (max-width: 60rem) { header { min-height: auto; } .header-grid { grid-template-columns: minmax(0, 1fr) minmax(15rem, 22rem); } }
  @media (max-width: 48rem) { .header-grid { grid-template-columns: 1fr; } figure { width: min(100%, 22rem); justify-self: start; } }
  @media (max-width: 36rem) { .article-meta { grid-template-columns: 1fr; } .article-meta > div + div { border-top: 1px solid color-mix(in srgb, var(--caramel) 22%, transparent); border-left: 0; } }
  @media (max-width: 30rem) { .article-body { padding: 0.75rem; } .reading-card { padding: 1.6rem 1.25rem 2rem; } :global(.reading-card .prose > p) { line-height: 1.82; } :global(.reading-card .drop-cap) { font-size: 3.5em; } }
  @media (prefers-reduced-motion: reduce) { .reading-progress span { transition: none; } }
</style>

<script>
  const article = document.querySelector<HTMLElement>('[data-blog-article]');
  const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
  const progressFill = progress?.querySelector<HTMLElement>('span');
  let progressFrame: number | undefined;

  const updateReadingProgress = () => {
    progressFrame = undefined;
    if (!article || !progress || !progressFill) return;

    const articleTop = window.scrollY + article.getBoundingClientRect().top;
    const scrollableDistance = Math.max(article.offsetHeight - window.innerHeight, 1);
    const amount = Math.min(1, Math.max(0, (window.scrollY - articleTop) / scrollableDistance));
    const percentage = Math.round(amount * 100);

    progressFill.style.transform = `scaleX(${amount})`;
    progress.setAttribute('aria-valuenow', String(percentage));
  };

  const requestProgressUpdate = () => {
    if (progressFrame !== undefined) return;
    progressFrame = window.requestAnimationFrame(updateReadingProgress);
  };

  window.addEventListener('scroll', requestProgressUpdate, { passive: true });
  window.addEventListener('resize', requestProgressUpdate);
  updateReadingProgress();
</script>
