---
import { readingTimeLabel, renderMarkdown } from '@tilana/content';
import SiteLayout from '@web/site/layouts/SiteLayout.astro';
import PostCard from '@web/site/components/PostCard.astro';
import Icon from '@web/site/components/Icon';
import { href } from '@web/site/config';
import { coverTone, coverWord, formatDate, getPosts, toCard } from '@web/site/blog';
import { setBlogCacheHeaders } from '@web/utils/blog-http';

// Rendered on request so edits and new posts appear without a rebuild.
export const prerender = false;
const posts = await getPosts();
const post = posts.find((item) => item.slug === Astro.params.slug);
// An empty 404 makes Astro show the site's normal "Page not found" page.
if (!post) return new Response(null, { status: 404 });
setBlogCacheHeaders(Astro.response.headers);

const others = posts.filter((item) => item.slug !== post.slug).slice(0, 3);
// Markdown is rendered with raw HTML disabled and unsafe links removed (see @tilana/content).
const bodyHtml = renderMarkdown(post.bodyMarkdown);
const readingTime = readingTimeLabel(post.bodyMarkdown);
const readingMinutes = Number.parseInt(readingTime, 10);
const canonical = new URL(`/blog/${post.slug}`, Astro.site).href;
const pageId = `${canonical}#webpage`;
const websiteId = new URL('/#website', Astro.site).href;
const personId = new URL('/#person', Astro.site).href;
const structuredData = [
  {
    '@type': 'WebPage',
    '@id': pageId,
    url: canonical,
    name: `${post.title} | Tilana van Tonder`,
    description: post.excerpt,
    isPartOf: { '@id': websiteId },
    about: { '@id': personId },
  },
  {
    '@type': 'BlogPosting',
    '@id': `${canonical}#article`,
    headline: post.title,
    description: post.excerpt,
    datePublished: post.publishedAt.toISOString(),
    dateModified: post.updatedAt.toISOString(),
    mainEntityOfPage: { '@id': pageId },
    isPartOf: { '@id': websiteId },
    author: { '@id': personId },
    publisher: { '@id': personId },
    ...(post.coverImageUrl ? { image: post.coverImageUrl } : {}),
    ...(Number.isFinite(readingMinutes) ? { timeRequired: `PT${readingMinutes}M` } : {}),
    inLanguage: 'en-ZA',
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: post.title, item: canonical },
    ],
  },
];
---
<SiteLayout
  title={post.title}
  description={post.excerpt}
  current="blog"
  image={post.coverImageUrl ?? undefined}
  imageAlt={post.coverImageAlt ?? undefined}
  imageWidth={post.coverImageUrl ? post.coverImageWidth ?? 944 : undefined}
  imageHeight={post.coverImageUrl ? post.coverImageHeight ?? 1104 : undefined}
  imageType={post.coverImageUrl ? 'image/webp' : undefined}
  pageType="article"
  publishedAt={post.publishedAt}
  structuredData={structuredData}
>
  <article>
    <header class="wrap article-head">
      <div>
        <a class="back-link" href={href('/blog')}>← Back to blog</a>
        <p class="eyebrow">A personal note from Tilana</p>
        <h1>{post.title}</h1>
        <p class="lede">{post.excerpt}</p>
        <dl class="article-meta">
          <div><dt>Published</dt><dd><time datetime={post.publishedAt.toISOString()}>{formatDate(post.publishedAt)}</time></dd></div>
          <div><dt>Reading time</dt><dd>{readingTime}</dd></div>
          <div><dt>Filed under</dt><dd>{post.category}</dd></div>
        </dl>
      </div>
      <figure class="article-cover">
        {post.coverImageUrl
          ? <img src={post.coverImageUrl} alt={post.coverImageAlt ?? ''} width={post.coverImageWidth ?? 944} height={post.coverImageHeight ?? 1104} loading="eager" decoding="async" fetchpriority="high" />
          : <div class={`type-cover tone-${coverTone(post)}`} aria-hidden="true"><span>{post.category}</span><strong>{coverWord(post)}</strong></div>}
      </figure>
    </header>

    <div class="wrap article-layout">
      <aside class="author">
        <img src="/images/site/tilana-portrait-480.webp" alt="" width="84" height="84" loading="lazy" />
        <div><strong>Tilana van Tonder</strong><span>Real, raw and honest notes on strength, food and family life.</span></div>
        <a class="link-arrow" href={href('/about')}>About me <Icon name="arrow" /></a>
      </aside>
      <div class="prose">
        <div class="post-body-text" set:html={bodyHtml} />
        <div class="article-closing">
          {post.closingLine && <p><strong>{post.closingLine}</strong></p>}
          <div class="article-signature"><span>With love,</span><strong>Tilana</strong></div>
        </div>
        {post.quoteText && (
          <blockquote class="bible-verse">
            <p>“{post.quoteText}”</p>
            {post.quoteCitation && <cite>{post.quoteCitation}</cite>}
          </blockquote>
        )}
        <p class="article-disclaimer"><strong>Please note:</strong> This article is general education based on lived experience. It does not diagnose, treat, or replace advice from an appropriately qualified healthcare professional.</p>
      </div>
    </div>
  </article>

  {others.length > 0 && (
    <section class="section wrap">
      <div class="section-head split" data-reveal>
        <div>
          <p class="eyebrow">More from the blog</p>
          <h2 class="h2">Keep <em>reading.</em></h2>
        </div>
        <a class="link-arrow" href={href('/blog')}>All articles <Icon name="arrow" /></a>
      </div>
      <div class="post-grid snap-mobile">{others.map((p, i) => <PostCard post={toCard(p)} delay={i * 0.08} />)}</div>
    </section>
  )}
</SiteLayout>
