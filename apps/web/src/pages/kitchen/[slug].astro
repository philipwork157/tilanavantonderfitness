---
import { renderMarkdown } from '@tilana/content';
import SiteLayout from '@web/site/layouts/SiteLayout.astro';
import Icon from '@web/site/components/Icon';
import RecipeCard from '@web/site/components/RecipeCard';
import RecipeMethod from '@web/site/components/RecipeMethod';
import { href } from '@web/site/config';
import { loadRecipes, recipeStructuredData, relatedRecipes, setKitchenCacheHeaders, toRecipeCard } from '@web/site/kitchen';

// Rendered on request so edits in the admin appear without a rebuild.
export const prerender = false;
const { recipes, ok } = await loadRecipes();
const recipe = recipes.find((item) => item.slug === Astro.params.slug);
// The admin could not be reached and there is no saved copy: ask the visitor to try again.
if (!recipe && !ok) return new Response('The recipes are taking a moment to load. Please refresh the page in a minute.', { status: 503, headers: { 'retry-after': '60', 'content-type': 'text/plain; charset=utf-8' } });
// An empty 404 makes Astro show the site's normal "Page not found" page.
if (!recipe) return new Response(null, { status: 404 });
setKitchenCacheHeaders(Astro.response.headers);

const others = relatedRecipes(recipe, recipes);
// Markdown is rendered with raw HTML disabled and unsafe links removed (see @tilana/content).
const notesHtml = recipe.notesMarkdown.trim() ? renderMarkdown(recipe.notesMarkdown) : '';
const d = recipe;
const n = d.nutrition;
const macroKcal = n.protein * 4 + n.carbs * 4 + n.fat * 9;
const macros = [
  { key: 'protein', label: 'Protein', g: n.protein, kcal: n.protein * 4 },
  { key: 'carbs', label: 'Carbs', g: n.carbs, kcal: n.carbs * 4 },
  { key: 'fat', label: 'Fat', g: n.fat, kcal: n.fat * 9 },
].map((m) => ({ ...m, pct: macroKcal ? Math.round((m.kcal / macroKcal) * 100) : 0 }));

// Recipe details for Google (time, servings, calories, ingredients and steps).
const canonical = new URL(`/kitchen/${d.slug}`, Astro.site).href;
const structuredData = [
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: d.title,
    description: d.description,
    isPartOf: { '@id': new URL('/#website', Astro.site).href },
    mainEntity: { '@id': `${canonical}#recipe` },
  },
  recipeStructuredData(d, canonical, new URL('/#person', Astro.site).href),
];
---
<SiteLayout title={d.title} description={d.description} current="kitchen" image={d.imageUrl ?? undefined} imageAlt={d.imageAlt ?? undefined} imageWidth={d.imageWidth ?? undefined} imageHeight={d.imageHeight ?? undefined} imageType={d.imageUrl ? 'image/webp' : undefined} pageType="article" publishedAt={d.publishedAt} structuredData={structuredData}>
  <article>
    <header class="wrap recipe-head">
      <div>
        <a class="back-link" href={href('/kitchen')}>← Back to the kitchen</a>
        <p class="eyebrow">{d.meal}</p>
        <h1>{d.title}</h1>
        <p class="lede">{d.description}</p>
        <dl class="article-meta recipe-meta">
          <div><dt>Prep</dt><dd>{d.prepMinutes} min</dd></div>
          {d.cookMinutes > 0 && <div><dt>Cook</dt><dd>{d.cookMinutes} min</dd></div>}
          <div><dt>Serves</dt><dd>{d.servings}</dd></div>
          <div><dt>Energy</dt><dd>{n.kcal} kcal</dd></div>
        </dl>
        {d.tags.length > 0 && <ul class="tag-list">{d.tags.map((t) => <li>{t}</li>)}</ul>}
      </div>
      <figure class={`recipe-cover tone-${d.tone}`}>
        {d.imageUrl ? <img src={d.imageUrl} alt={d.imageAlt ?? ''} width={d.imageWidth ?? undefined} height={d.imageHeight ?? undefined} /> : <Icon name={d.icon} className="recipe-cover-icon" />}
        <span class="recipe-protein recipe-protein-lg" aria-label={`${n.protein} grams of protein per serving`}>
          <b aria-hidden="true">{n.protein}<i>g</i></b>
          <small aria-hidden="true">protein a serving</small>
        </span>
      </figure>
    </header>

    <div class="wrap recipe-layout">
      <div class="recipe-main">
        <RecipeMethod client:visible servings={d.servings} ingredients={d.ingredients} steps={d.steps} />
        {notesHtml && (
          <section class="prose recipe-notes" aria-labelledby="notes-title">
            <h2 id="notes-title">Tilana’s notes</h2>
            <Fragment set:html={notesHtml} />
          </section>
        )}
      </div>
      <aside class="recipe-side">
        <section class="nutri card" aria-labelledby="nutri-title">
          <h2 id="nutri-title">Per serving</h2>
          <p class="nutri-kcal"><b>{n.kcal}</b> kcal</p>
          <ul class="nutri-bars">
            {macros.map((m) => (
              <li class={`nutri-${m.key}`}>
                <span>{m.label}</span><b>{m.g} g</b>
                <i style={`--w:${m.pct}%`} aria-hidden="true"></i>
                <small>{m.pct}% of energy</small>
              </li>
            ))}
          </ul>
          <p class="nutri-note">Estimated from standard food values. Brands and portions vary, so treat it as a guide.</p>
        </section>
        <section class="protein-note card tone-terracotta" aria-labelledby="pn-title">
          <h2 id="pn-title"><Icon name="spark" />The protein part</h2>
          <p>{d.proteinNote}</p>
          <a class="link-arrow" href={href('/kitchen#why-protein')}>Why protein matters <Icon name="arrow" /></a>
        </section>
        {d.fromPost && (
          <a class="from-post card lift" href={href(`/blog/${d.fromPost.slug}`)}>
            <small>From the blog</small>
            <strong>{d.fromPost.title}</strong>
            <span class="link-arrow">Read the post <Icon name="arrow" /></span>
          </a>
        )}
      </aside>
    </div>
  </article>

  {others.length > 0 && <section class="section wrap">
    <div class="section-head split" data-reveal>
      <div>
        <p class="eyebrow">More from the kitchen</p>
        <h2 class="h2">Hungry for <em>more?</em></h2>
      </div>
      <a class="link-arrow" href={href('/kitchen')}>All recipes <Icon name="arrow" /></a>
    </div>
    <div class="recipe-grid snap-mobile">{others.map((r) => <RecipeCard recipe={toRecipeCard(r)} />)}</div>
  </section>}
</SiteLayout>
