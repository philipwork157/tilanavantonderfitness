---
import SiteLayout from '@web/site/layouts/SiteLayout.astro';
import { href } from '@web/site/config';
---
<SiteLayout title="Page not found" current="legal" newsletter={false} robots="noindex, follow" description="The page you were looking for could not be found.">
  <section class="wrap">
    <div class="done-wrap">
      <div class="done-card">
        <span class="done-alert" aria-hidden="true">?</span>
        <p class="done-eyebrow">Error 404</p>
        <h1>This page took a <em>rest day.</em></h1>
        <p class="done-lede">The page you were looking for isn't here - it may have moved or never existed. Let's get you back on track.</p>
        <div class="done-actions">
          <a class="btn btn-primary" href={href('/')}>Back to home</a>
          <a class="btn btn-ghost" href={href('/program')}>Explore the programs</a>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
