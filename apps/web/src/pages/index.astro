---
import SiteLayout from '@web/site/layouts/SiteLayout.astro';
import Img from '@web/site/components/Img.astro';
import Icon from '@web/site/components/Icon';
import ProgramCard from '@web/site/components/ProgramCard.astro';
import DisciplinePicker from '@web/site/components/DisciplinePicker';
import NumbersCalculator from '@web/site/components/NumbersCalculator';
import MythCards from '@web/site/components/MythCards';
import { checkoutEnabled, href } from '@web/site/config';
import { disciplines, myths, programs, values } from '@web/site/data';

const pickerItems = disciplines.map((d) => {
  const p = programs.find((x) => x.key === d.program);
  return { ...d, href: href(d.link.path), programName: p?.name };
});
const nourish = programs.find((p) => p.key === 'nourish')!;
---
<SiteLayout title="Strength, Movement & Healthy Habits" current="home">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Realistic strength for every body</p>
        <h1 class="display hero-title">
          <span class="line"><span style="--i:0">Move better.</span></span>
          <span class="line"><span style="--i:1">Feel stronger.</span></span>
          <span class="line"><span style="--i:2"><em>Live healthier.</em></span></span>
        </h1>
        <p class="lede" data-reveal data-reveal-delay="0.45">Whether you are a woman or a man, lasting strength is built through purposeful movement and maintainable systems that work in real life. No perfection to chase and no quick fix to sell, only practical habits and steady progress.</p>
        <div class="hero-ctas" data-reveal data-reveal-delay="0.55">
          <a class="btn btn-primary" href={href('/program')}>Explore the programs <Icon name="arrow" /></a>
          <a class="btn" href={href('/about')}>Meet Tilana</a>
        </div>
      </div>
      <div class="hero-visual" data-reveal data-reveal-delay="0.2">
        <div class="hero-arch">
          <Img name="tilana-home" alt="Tilana van Tonder smiling with her arms crossed" sizes="(max-width: 52rem) 78vw, 25rem" priority />
        </div>
        <div class="spin-badge" aria-hidden="true">
          <svg viewBox="0 0 200 200">
            <defs><path id="badge-circle" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" /></defs>
            <text><textPath href="#badge-circle" textLength="482" lengthAdjust="spacing">REAL · RAW · HONEST · REAL · RAW · HONEST ·</textPath></text>
          </svg>
          <span class="spin-core"><Icon name="spark" /></span>
        </div>
        <div class="sticker sticker-a tone-sage"><strong>4:04</strong> marathon<br /><small>six months after giving birth</small></div>
        <div class="sticker sticker-b tone-white">No perfect bodies.<br /><small>Just strong ones.</small></div>
      </div>
    </div>
  </section>

  <section class="section wrap" id="disciplines">
    <div class="section-head split" data-reveal>
      <div>
        <p class="eyebrow">Find your strong</p>
        <h2 class="h2">Pick your <em>thing.</em></h2>
      </div>
      <p class="lede">Every body moves differently. Tap a discipline to see how Tilana approaches it, and which program fits.</p>
    </div>
    <DisciplinePicker client:visible items={pickerItems} />
  </section>

  <section class="section band" id="programs">
    <div class="wrap">
      <div class="section-head split" data-reveal>
        <div>
          <p class="eyebrow">The program collection</p>
          <h2 class="h2">Start today, <em>at your pace.</em></h2>
        </div>
        <p class="lede">{checkoutEnabled
          ? 'Choose one or a few. Add them to your basket and pay once, securely with Paystack. Every program is a once-off purchase.'
          : 'Choose one or a few and get in touch. Every program is a once-off purchase, emailed to you as a PDF.'}</p>
      </div>
      <div class="prog-grid snap-mobile">
        {programs.map((p, i) => <ProgramCard program={p} index={i} />)}
        <article class="prog-card card private-card" data-reveal data-reveal-delay="0.16">
          <p class="eyebrow">Private training</p>
          <h3>Want to train <em>one-on-one?</em></h3>
          <p>Please contact me to discuss private training: a plan built around you, with regular check-ins along the way.</p>
          <div class="private-actions">
            <a class="btn btn-accent" href={href('/contact?interest=one-on-one')}>Get in touch <Icon name="arrow" /></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section wrap" id="numbers">
    <div class="section-head" data-reveal>
      <p class="eyebrow">Your starting point</p>
      <h2 class="h2">Know your numbers, <em>gently.</em></h2>
      <p class="lede">A quick estimate of what your body needs. It’s the beginning of the conversation, not a rulebook.</p>
    </div>
    <NumbersCalculator client:visible nourishHref={href(`/program#${nourish.key}`)} />
  </section>

  <section class="section band" id="myths">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Myth vs fact</p>
        <h2 class="h2">Things we’re <em>done</em> believing.</h2>
      </div>
      <MythCards client:visible items={myths} />
    </div>
  </section>

  <section class="section">
    <div class="wrap meet-grid">
      <figure class="meet-photo" data-reveal>
        <Img name="tilana-strength" alt="Tilana doing a dumbbell split squat in the gym" sizes="(max-width: 52rem) 92vw, 34rem" />
      </figure>
      <div class="meet-copy" data-reveal data-reveal-delay="0.1">
        <p class="eyebrow">Meet Tilana</p>
        <h2 class="h2">Hi, I’m <em>Tilana.</em></h2>
        <blockquote>“Today I train because I love what my body can do, not because I’m trying to earn my worth.”</blockquote>
        <p>I’m not perfect, and I don’t want to pretend to be. I’m simply someone who loves movement, values health, and wants to be strong enough to enjoy every season.</p>
        <ul class="meet-values">
          {values.map((v) => <li class={`tone-${v.tone}`}><b>{v.n}</b><strong>{v.title}</strong><span>{v.copy}</span></li>)}
        </ul>
        <a class="btn btn-primary" href={href('/about')}>Read my story <Icon name="arrow" /></a>
      </div>
    </div>
  </section>
</SiteLayout>
