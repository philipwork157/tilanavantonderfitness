---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import heroImage from '../assets/tilana-home.jpg';
---
<BaseLayout title="Strength, Movement & Healthy Habits">
  <div class="sale-banner-spacer" aria-hidden="true"></div>
  <aside class="sale-banner" aria-label="Programme sale">
    <div class="sale-banner-inner">
      <a class="sale-marquee" href="/program#program-collection" aria-label="30% sale, 2-4 October 2026. Don't miss this opportunity. Explore the sale.">
        <div class="sale-track" aria-hidden="true">
          {[0, 1].map(() => <div class="sale-group">
            {[0, 1].map(() => <span class="sale-message"><strong>30% SALE</strong><span class="sale-dates">2-4 October 2026</span><span>Don't miss this opportunity.</span><span class="sale-link">Explore the sale &rarr;</span></span>)}
          </div>)}
        </div>
      </a>
    </div>
  </aside>
  <section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow">Realistic strength for every body</p><h1 class="display"><span class="hero-line">Move better.</span><span class="hero-line">Feel stronger.</span><span class="hero-line script">Live healthier.</span></h1><p class="lede">Whether you are a woman or a man, lasting strength is built through purposeful movement and maintainable systems that work in real life. There is no perfection to chase and no quick fix to sell - only practical habits, steady progress, and a lifelong investment in moving well, feeling capable, and living with greater confidence.</p><div class="actions"><a class="button button-primary" href="/program">Explore the program</a><a class="button button-secondary" href="/about">Meet Tilana</a></div></div><div class="hero-visual"><Image src={heroImage} alt="Tilana van Tonder smiling with her arms crossed" widths={[432, 768, 1023]} sizes="(max-width: 48rem) 92vw, 27rem" loading="eager" fetchpriority="high" /></div></div></section>
  <section class="simple-cta"><div class="container" data-reveal><h2 class="heading-xl">Want to train one-on-one?</h2><p class="cta-copy">Please contact me to discuss private training.</p><a class="button button-dark" href="/contact?interest=one-on-one">Get in touch</a></div></section>
</BaseLayout>
<style>
  .sale-banner { position: fixed; top: calc(5.5rem + 1px); left: 0; z-index: 25; width: 100%; border-bottom: 1px solid #b6c6a3; color: #35462f; background: #dce5ce; box-shadow: 0 4px 14px rgb(67 88 61 / 10%); }
  .sale-banner-spacer { height: 4rem; }
  .sale-banner-inner { display: flex; align-items: center; gap: 0.75rem; padding-block: 0.9rem; }
  .sale-marquee { flex: 1; min-width: 0; overflow: hidden; }
  .sale-track { display: flex; width: max-content; animation: sale-scroll 36s linear infinite; }
  .sale-group { display: flex; flex: none; gap: 3rem; padding-right: 3rem; }
  .sale-message { display: inline-flex; align-items: center; gap: 1rem; white-space: nowrap; font-size: 0.85rem; line-height: 1.5; }
  .sale-link { font-weight: 750; text-decoration: underline; text-underline-offset: 0.2rem; }
  .sale-banner:hover .sale-track, .sale-banner:focus-within .sale-track { animation-play-state: paused; }
  @keyframes sale-scroll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .sale-banner-inner { padding-inline: var(--page-pad); }
    .sale-track { width: 100%; animation: none; }
    .sale-group { width: 100%; padding: 0; }
    .sale-message { justify-content: center; flex-wrap: wrap; white-space: normal; }
    .sale-group:nth-child(2), .sale-message:nth-child(2) { display: none; }
  }
  .sale-banner strong { padding: 0.3rem 0.65rem; border-radius: var(--radius-pill); color: #fff; background: #43583d; font-size: 0.8rem; letter-spacing: 0.06em; }
  .sale-dates { font-weight: 750; }
  .sale-banner a { color: #35462f; text-decoration: none; }
  .sale-banner a:hover { text-decoration-thickness: 2px; }
  .sale-banner a:focus-visible { outline: 2px solid #35462f; outline-offset: 5px; border-radius: 2px; }
  .hero { display: grid; min-height: calc(100svh - 5.5rem); align-items: center; overflow: hidden; padding-block: clamp(2rem, 5vh, 4.5rem); }
  .hero-grid { display: grid; align-items: center; gap: clamp(2.5rem, 5vw, 5rem); grid-template-columns: minmax(0, 1.08fr) minmax(19rem, 0.92fr); }
  .hero-copy { max-width: 41rem; }
  .hero .display { font-size: clamp(3.7rem, 5.8vw, 5.75rem); }
  .hero-line { display: block; white-space: nowrap; }
  .hero .lede { margin: 1.6rem 0 2rem; }
  .hero-copy > * { animation: hero-in 720ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .hero-copy .display { animation-delay: 80ms; }
  .hero-copy .lede { animation-delay: 160ms; }
  .hero-copy .actions { animation-delay: 240ms; }
  .hero-visual { width: min(100%, 27rem); overflow: hidden; justify-self: center; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--sand); box-shadow: var(--shadow-md); animation: visual-in 900ms 160ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .hero-visual img { display: block; width: 100%; height: auto; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .simple-cta { padding-block: var(--section-space); text-align: center; background: var(--terracotta); }
  .simple-cta :is(.heading-xl, .cta-copy) { color: var(--color-on-primary); }
  .simple-cta .heading-xl { margin-bottom: 0.75rem; }
  .simple-cta .cta-copy { margin: 0 auto 2rem; font-size: 1.05rem; }
  @keyframes hero-in { from { opacity: 0; transform: translateY(1.8rem); } }
  @keyframes visual-in { from { opacity: 0; transform: translateX(2rem) scale(0.96); } }
  @media (max-width: 48rem) {
    .sale-banner { top: calc(4.75rem + 1px); }
    .hero { min-height: auto; padding-block: 3.5rem 4.5rem; }
    .hero-grid { grid-template-columns: 1fr; }
    .hero-line { white-space: normal; }
  }
  @media (max-width: 30rem) {
    .actions .button { width: 100%; }
    .hero-visual { width: 100%; }
  }
</style>

<script>
  const saleBanner = document.querySelector<HTMLElement>('.sale-banner');
  const saleSpacer = document.querySelector<HTMLElement>('.sale-banner-spacer');
  const siteHeader = document.querySelector<HTMLElement>('.site-header');
  const syncSalePosition = () => {
    if (!saleBanner || !saleSpacer) return;
    if (siteHeader) saleBanner.style.top = `${siteHeader.getBoundingClientRect().height}px`;
    saleSpacer.style.height = `${saleBanner.getBoundingClientRect().height}px`;
  };
  if (saleBanner) {
    const saleResizeObserver = new ResizeObserver(syncSalePosition);
    saleResizeObserver.observe(saleBanner);
    if (siteHeader) saleResizeObserver.observe(siteHeader);
    syncSalePosition();
  }
</script>
