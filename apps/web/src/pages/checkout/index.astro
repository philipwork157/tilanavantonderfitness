---
import PageHero from '@tilana/ui-astro/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const catalogueApiBaseUrl = (
  import.meta.env.PUBLIC_CATALOGUE_API_BASE_URL
  ?? 'http://127.0.0.1:3001/api/public'
).replace(/\/+$/, '');
const checkoutApiUrl = (
  import.meta.env.PUBLIC_CHECKOUT_API_URL
  ?? 'http://127.0.0.1:3001/api/checkout/paystack'
).replace(/\/+$/, '');
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---

<BaseLayout title="Your programme basket" description="Buy Tilana van Tonder programmes securely through Paystack." showNewsletter={false}>
  <PageHero eyebrow="Your basket" title="Choose more." script="Pay once." intro="Review your programmes, enter your details, and complete one secure payment." />

  <section
    class="section checkout-section"
    data-checkout
    data-catalogue-api-url={`${catalogueApiBaseUrl}/program-volumes`}
    data-checkout-api-url={`${checkoutApiUrl}/basket`}
    aria-busy="true"
  >
    <div class="container">
      <div class="checkout-state" data-checkout-loading role="status">
        <span class="state-icon" aria-hidden="true">•••</span>
        <div><h2>Loading your basket</h2><p>Confirming the latest programmes and prices.</p></div>
      </div>

      <div class="checkout-state checkout-error" data-checkout-error role="alert" hidden>
        <span class="state-icon" aria-hidden="true">!</span>
        <div><h2 data-error-title>Your basket is empty</h2><p data-error-copy>Add a programme before continuing to payment.</p></div>
        <div class="state-actions">
          <button type="button" class="button button-secondary" data-checkout-retry hidden>Try again</button>
          <a class="button button-dark" href="/program">Browse programmes</a>
        </div>
      </div>

      <div class="checkout-grid" data-checkout-content hidden>
        <aside class="order-card">
          <div class="order-heading">
            <div><p class="eyebrow">Your selection</p><h2 data-basket-heading>Your basket</h2></div>
            <a href="/program">Add another</a>
          </div>
          <div class="basket-items" data-basket-items></div>
          <div class="price"><span>Total once-off payment</span><strong data-basket-total></strong></div>
          <ul>
            <li>One secure Paystack payment</li>
            <li>No account needed before payment</li>
            <li>Every purchased programme is linked when you verify your email</li>
          </ul>
        </aside>

        <form class="checkout-form" data-checkout-form novalidate>
          <div class="honeypot" aria-hidden="true"><label>Leave empty<input name="website" tabindex="-1" autocomplete="off" /></label></div>
          <div class="name-grid">
            <label>First name<input name="firstName" autocomplete="given-name" maxlength="100" required /></label>
            <label>Last name<input name="lastName" autocomplete="family-name" maxlength="100" required /></label>
          </div>
          <label>Email address<input name="email" type="email" autocomplete="email" maxlength="254" required /></label>
          <label>Phone number <small>(optional)</small><input name="phone" type="tel" autocomplete="tel" maxlength="30" /></label>
          <label class="consent">
            <input name="consent" type="checkbox" required />
            <span>I agree to the <a href="/privacy">privacy policy</a> and understand these are digital programmes providing general education, not clinical care.</span>
          </label>
          {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="checkout" data-theme="auto"></div>}
          <button class="button button-primary" type="submit"><span>Pay securely for my programmes</span></button>
          <p class="form-status" data-form-status role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import {
    catalogueSlugSchema,
    publicCatalogueVolumeResponseSchema,
    type PublicCatalogueVolumeDetail,
  } from '@tilana/contracts/catalogue';
  import { basketCheckoutRequestSchema } from '@tilana/contracts/checkout';
  import {
    addToBasket,
    readBasket,
    rememberPendingBasket,
    removeFromBasket,
    writeBasket,
  } from '../../scripts/basket';

  type ApiMessage = { authorizationUrl?: string; reference?: string; statusMessage?: string; message?: string };

  const priceFormatter = new Intl.NumberFormat('en-ZA', {
    style: 'currency',
    currency: 'ZAR',
    maximumFractionDigits: 2,
  });
  const root = document.querySelector<HTMLElement>('[data-checkout]');
  const loading = root?.querySelector<HTMLElement>('[data-checkout-loading]');
  const errorPanel = root?.querySelector<HTMLElement>('[data-checkout-error]');
  const errorTitle = root?.querySelector<HTMLElement>('[data-error-title]');
  const errorCopy = root?.querySelector<HTMLElement>('[data-error-copy]');
  const retry = root?.querySelector<HTMLButtonElement>('[data-checkout-retry]');
  const content = root?.querySelector<HTMLElement>('[data-checkout-content]');
  const itemsContainer = root?.querySelector<HTMLElement>('[data-basket-items]');
  const heading = root?.querySelector<HTMLElement>('[data-basket-heading]');
  const total = root?.querySelector<HTMLElement>('[data-basket-total]');
  const form = root?.querySelector<HTMLFormElement>('[data-checkout-form]');
  const status = form?.querySelector<HTMLElement>('[data-form-status]');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const buttonLabel = button?.querySelector<HTMLElement>('span');
  let selectedVolumes: PublicCatalogueVolumeDetail[] = [];

  function showError(title: string, copy: string, canRetry: boolean) {
    if (!root || !errorPanel || !errorTitle || !errorCopy) return;
    loading?.setAttribute('hidden', '');
    content?.setAttribute('hidden', '');
    errorTitle.textContent = title;
    errorCopy.textContent = copy;
    retry?.toggleAttribute('hidden', !canRetry);
    errorPanel.removeAttribute('hidden');
    root.setAttribute('aria-busy', 'false');
  }

  async function readJson(response: Response): Promise<ApiMessage | null> {
    return response.json().catch(() => null) as Promise<ApiMessage | null>;
  }

  function renderBasket() {
    if (!root || !itemsContainer || !heading || !total) return;
    if (!selectedVolumes.length) {
      showError('Your basket is empty', 'Add a programme before continuing to payment.', false);
      return;
    }

    const rows = selectedVolumes.map((volume) => {
      const row = document.createElement('article');
      row.className = 'basket-item';
      const details = document.createElement('div');
      const programName = document.createElement('span');
      programName.textContent = volume.program.name;
      const volumeName = document.createElement('strong');
      volumeName.textContent = volume.name;
      details.append(programName, volumeName);
      const actions = document.createElement('div');
      const price = document.createElement('strong');
      price.textContent = priceFormatter.format(volume.priceCents / 100);
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.textContent = 'Remove';
      remove.setAttribute('aria-label', `Remove ${volume.name} from basket`);
      remove.addEventListener('click', () => {
        removeFromBasket(volume.slug);
        selectedVolumes = selectedVolumes.filter(item => item.slug !== volume.slug);
        renderBasket();
      });
      actions.append(price, remove);
      row.append(details, actions);
      return row;
    });
    itemsContainer.replaceChildren(...rows);
    const count = selectedVolumes.length;
    heading.textContent = `${count} ${count === 1 ? 'programme' : 'programmes'}`;
    const totalCents = selectedVolumes.reduce((sum, volume) => sum + volume.priceCents, 0);
    total.textContent = priceFormatter.format(totalCents / 100);
    errorPanel?.setAttribute('hidden', '');
    content?.removeAttribute('hidden');
    root.setAttribute('aria-busy', 'false');
  }

  async function fetchVolume(slug: string): Promise<PublicCatalogueVolumeDetail | null> {
    if (!root) return null;
    const response = await fetch(`${root.dataset.catalogueApiUrl}/${encodeURIComponent(slug)}`, {
      headers: { Accept: 'application/json' },
    });
    const body: unknown = await response.json().catch(() => null);
    const parsed = publicCatalogueVolumeResponseSchema.safeParse(body);
    if (!response.ok || !parsed.success || !parsed.data.volume.isAvailable) return null;
    return parsed.data.volume;
  }

  async function loadBasket() {
    if (!root) return;
    root.setAttribute('aria-busy', 'true');
    loading?.removeAttribute('hidden');
    errorPanel?.setAttribute('hidden', '');
    content?.setAttribute('hidden', '');

    const querySlug = new URLSearchParams(window.location.search).get('programme');
    const parsedQuerySlug = catalogueSlugSchema.safeParse(querySlug);
    if (parsedQuerySlug.success) addToBasket(parsedQuerySlug.data);
    const slugs = readBasket();
    if (!slugs.length) {
      showError('Your basket is empty', 'Browse the programme collection and add anything you would like to purchase.', false);
      return;
    }

    try {
      const volumes = await Promise.all(slugs.map(fetchVolume));
      selectedVolumes = volumes.filter((volume): volume is PublicCatalogueVolumeDetail => volume !== null);
      if (selectedVolumes.length !== slugs.length) writeBasket(selectedVolumes.map(volume => volume.slug));
      loading?.setAttribute('hidden', '');
      if (!selectedVolumes.length) {
        showError('Your programmes are unavailable', 'The programmes in your basket are no longer available. Please choose from the current collection.', false);
        return;
      }
      renderBasket();
    } catch {
      showError('Basket could not be loaded', 'Please try again in a moment.', true);
    }
  }

  retry?.addEventListener('click', () => void loadBasket());
  void loadBasket();

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!root || !form || !status || !button || !buttonLabel || !selectedVolumes.length) return;
    const data = new FormData(form);
    const parsed = basketCheckoutRequestSchema.safeParse({
      items: selectedVolumes.map(volume => ({
        volumeSlug: volume.slug,
        expectedPriceCents: volume.priceCents,
      })),
      firstName: data.get('firstName'),
      lastName: data.get('lastName'),
      email: data.get('email'),
      phone: data.get('phone'),
      consent: data.get('consent') === 'on',
      website: data.get('website'),
      turnstileToken: String(data.get('cf-turnstile-response') ?? ''),
    });

    if (!parsed.success) {
      status.textContent = 'Please complete all required details and accept the privacy agreement.';
      status.dataset.state = 'error';
      return;
    }

    button.disabled = true;
    buttonLabel.textContent = 'Opening Paystack…';
    status.textContent = '';
    delete status.dataset.state;

    try {
      const response = await fetch(root.dataset.checkoutApiUrl ?? '', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(parsed.data),
      });
      const body = await readJson(response);
      if (!response.ok || !body?.authorizationUrl || !body.reference) {
        if (response.status === 409) {
          await loadBasket();
          throw new Error(body?.statusMessage ?? body?.message ?? 'Your basket changed. Please review it before paying.');
        }
        throw new Error(body?.statusMessage ?? body?.message ?? 'Checkout could not be started.');
      }
      rememberPendingBasket(body.reference, selectedVolumes.map(volume => volume.slug));
      window.location.assign(body.authorizationUrl);
    } catch (checkoutError) {
      status.textContent = checkoutError instanceof Error ? checkoutError.message : 'Checkout could not be started.';
      status.dataset.state = 'error';
      button.disabled = false;
      buttonLabel.textContent = 'Pay securely for my programmes';
      (window as Window & { turnstile?: { reset: () => void } }).turnstile?.reset();
    }
  });
</script>

<style>
  .checkout-section { min-height: 42rem; background: var(--cream); }
  .checkout-grid { display: grid; align-items: start; gap: clamp(2rem, 6vw, 5rem); grid-template-columns: 0.95fr 1.05fr; }
  .checkout-state { display: flex; min-height: 12rem; align-items: center; gap: 1rem; padding: clamp(1.5rem, 4vw, 2.5rem); border: 1px dashed var(--color-border); border-radius: var(--radius-lg); background: var(--white); }
  .checkout-state .state-icon { display: grid; width: 3rem; height: 3rem; flex: none; place-items: center; border-radius: 1rem; color: var(--ink); background: var(--sage); font-weight: 800; letter-spacing: 0.08em; }
  .checkout-error .state-icon { background: var(--terracotta); }
  .checkout-state h2, .checkout-state p { margin: 0; }
  .checkout-state h2 { color: var(--ink); font-family: var(--font-heading); font-size: clamp(1.5rem, 3vw, 2.1rem); }
  .checkout-state p { margin-top: 0.35rem; line-height: 1.6; }
  .state-actions { display: flex; flex-wrap: wrap; gap: 0.65rem; margin-left: auto; }
  .order-card, .checkout-form { padding: clamp(1.5rem, 4vw, 2.5rem); border: 1px solid var(--color-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); }
  .order-card { background: var(--sage); }
  .order-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; }
  .order-heading h2 { margin: 0.45rem 0 0; font-family: var(--font-heading); font-size: clamp(1.8rem, 4vw, 2.6rem); }
  .order-heading > a { flex: none; padding-bottom: 0.35rem; color: var(--chocolate); font-size: 0.72rem; font-weight: 750; text-decoration: underline; text-underline-offset: 0.2rem; }
  .basket-items { display: grid; margin-top: 1.5rem; border-top: 1px solid rgb(15 14 19 / 15%); }
  :global(.basket-item) { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 1rem; border-bottom: 1px solid rgb(15 14 19 / 15%); }
  :global(.basket-item > div) { display: grid; gap: 0.2rem; }
  :global(.basket-item > div:last-child) { justify-items: end; }
  :global(.basket-item span) { color: var(--chocolate); font-size: 0.68rem; font-weight: 750; letter-spacing: 0.08em; text-transform: uppercase; }
  :global(.basket-item strong) { color: var(--ink); font-size: 0.82rem; }
  :global(.basket-item button) { padding: 0; border: 0; color: var(--chocolate); background: transparent; font: inherit; font-size: 0.68rem; text-decoration: underline; cursor: pointer; }
  .order-card ul { display: grid; gap: 0.65rem; margin: 1.5rem 0 0; padding-left: 1.2rem; font-size: 0.78rem; }
  .price { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-top: 1.5rem; }
  .price span { max-width: 10rem; font-size: 0.7rem; font-weight: 750; letter-spacing: 0.08em; text-transform: uppercase; }
  .price strong { font-family: var(--font-heading); font-size: clamp(2rem, 4vw, 2.6rem); }
  .checkout-form { position: relative; display: grid; gap: 1.2rem; background: var(--white); }
  .checkout-form label:not(.consent) { display: grid; gap: 0.45rem; color: var(--ink); font-size: 0.75rem; font-weight: 700; }
  .checkout-form input:not([type="checkbox"]) { width: 100%; padding: 0.9rem 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); color: var(--ink); background: var(--cream); font: inherit; }
  .checkout-form input:focus { border-color: var(--caramel); outline: 3px solid rgb(213 162 127 / 22%); }
  .name-grid { display: grid; gap: 1rem; grid-template-columns: 1fr 1fr; }
  .consent { display: flex; align-items: flex-start; gap: 0.75rem; font-size: 0.72rem; line-height: 1.6; }
  .consent input { margin-top: 0.25rem; }
  .consent a { text-decoration: underline; }
  .form-status { min-height: 1em; margin: 0; font-size: 0.75rem; }
  .form-status[data-state="error"] { color: #9d2d24; }
  .honeypot { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .checkout-section [hidden] { display: none !important; }
  @media (max-width: 48rem) {
    .checkout-grid { grid-template-columns: 1fr; }
    .checkout-state { align-items: flex-start; flex-wrap: wrap; }
    .state-actions { width: 100%; margin-left: 0; }
  }
  @media (max-width: 30rem) {
    .name-grid { grid-template-columns: 1fr; }
    .state-actions .button { width: 100%; }
    :global(.basket-item) { align-items: flex-start; }
  }
</style>
