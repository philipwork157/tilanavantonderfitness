---
export function getStaticPaths() {
  return [
    'strong-volume-1',
    'move-volume-1',
    'nourish-volume-1',
    'reconnect-volume-1',
  ].map(programme => ({ params: { programme } }));
}

return Astro.redirect(`/checkout?programme=${encodeURIComponent(Astro.params.programme ?? '')}`, 308);
---
