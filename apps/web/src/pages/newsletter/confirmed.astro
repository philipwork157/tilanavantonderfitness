---
import BaseLayout from '@web/layouts/BaseLayout.astro';
import { publicApiUrl } from '@web/utils/public-api';

const confirmApiUrl = publicApiUrl('/api/newsletter/confirm');
---

<BaseLayout
  title="Newsletter subscription"
  description="Manage your Tilana van Tonder newsletter subscription."
  showNewsletter={false}
  robots="noindex, nofollow"
>
  <section class="result-section">
    <div class="container">
      <article data-newsletter-result data-api-url={confirmApiUrl}>
        <span class="result-mark" aria-hidden="true" data-nl-mark>↻</span>
        <p class="eyebrow">Newsletter</p>
        <h1 class="heading-lg" data-nl-title>Confirming your subscription…</h1>
        <p data-nl-body>One moment while we check your confirmation link.</p>
        <a class="button button-primary" href="/">Return home</a>
      </article>
    </div>
  </section>

  <script is:inline>
    (() => {
      // The link in the confirmation email opens this page with ?token=...
      // Confirming needs this page's request, so link scanners in email apps
      // cannot subscribe someone by just opening the link.
      const article = document.querySelector('[data-newsletter-result]');
      const mark = document.querySelector('[data-nl-mark]');
      const title = document.querySelector('[data-nl-title]');
      const body = document.querySelector('[data-nl-body]');
      const token = new URLSearchParams(window.location.search).get('token');

      const show = (ok) => {
        if (mark) mark.textContent = ok ? '✓' : '↻';
        if (title) title.textContent = ok ? 'You’re on the list.' : 'That link is no longer valid.';
        if (body) {
          body.textContent = ok
            ? 'Thank you for confirming. Thoughtful training guidance and programme updates will arrive occasionally.'
            : 'Confirmation links expire after 48 hours. Please return to the website and subscribe again to receive a new link.';
        }
        document.title = (ok ? 'Subscription confirmed' : 'Confirmation link expired') + ' | Tilana van Tonder';
      };

      if (!token || !article) {
        show(false);
        return;
      }
      fetch(article.dataset.apiUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token }),
      })
        .then((response) => show(response.ok))
        .catch(() => {
          if (title) title.textContent = 'We could not confirm just now.';
          if (body) body.textContent = 'Please check your connection and open the link from the email again.';
        });
    })();
  </script>
</BaseLayout>

<style>
  .result-section { display: grid; min-height: 62vh; place-items: center; padding-block: var(--section-space); background: color-mix(in srgb, var(--cream) 82%, var(--sage)); }
  article { max-width: 42rem; margin-inline: auto; padding: clamp(2rem, 6vw, 4rem); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--white); box-shadow: var(--shadow-md); text-align: center; }
  .result-mark { display: grid; width: 4rem; height: 4rem; margin: 0 auto 1.5rem; place-items: center; border-radius: 50%; color: var(--ink); background: var(--sage); font-size: 1.8rem; }
  article > p:not(.eyebrow) { max-width: 34rem; margin: 1.2rem auto 2rem; color: var(--chocolate); }
</style>
