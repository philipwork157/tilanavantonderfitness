---
import SiteLayout from '@web/site/layouts/SiteLayout.astro';
import { href } from '@web/site/config';
import { publicApiUrl } from '@web/utils/public-api';

const unsubscribeApiUrl = publicApiUrl('/api/newsletter/unsubscribe');
---
<SiteLayout title="Unsubscribe from the newsletter" current="legal" newsletter={false} robots="noindex, nofollow" description="Manage your Tilana van Tonder newsletter subscription.">
  <section class="wrap">
    <div class="done-wrap">
      <article class="done-card" data-unsubscribe-page data-api-url={unsubscribeApiUrl}>
        <span class="done-alert" aria-hidden="true" data-mark>♡</span>
        <p class="done-eyebrow">Newsletter preferences</p>
        <h1 data-title>Would you like to unsubscribe?</h1>
        <p class="done-lede" data-body>You will no longer receive Tilana’s occasional training guidance and blog updates.</p>
        <div class="done-actions" data-actions>
          <button class="btn btn-primary" type="button" data-unsubscribe>Yes, unsubscribe me</button>
          <a class="btn btn-ghost" href={href('/')}>Keep me subscribed</a>
        </div>
      </article>
    </div>
  </section>

  <script is:inline>
    (() => {
      const page = document.querySelector('[data-unsubscribe-page]');
      const button = document.querySelector('[data-unsubscribe]');
      const title = document.querySelector('[data-title]');
      const body = document.querySelector('[data-body]');
      const mark = document.querySelector('[data-mark]');
      const actions = document.querySelector('[data-actions]');
      const token = new URLSearchParams(window.location.search).get('token');
      const homeOnly = () => {
        if (!actions) return;
        const home = document.createElement('a');
        home.className = 'btn btn-primary';
        home.href = '/';
        home.textContent = 'Return home';
        actions.replaceChildren(home);
      };
      if (!page || !button || !token) {
        if (title) title.textContent = 'This link is not valid.';
        if (body) body.textContent = 'Please use the unsubscribe link from your most recent newsletter.';
        homeOnly();
        return;
      }
      button.addEventListener('click', async () => {
        button.disabled = true;
        button.textContent = 'Updating…';
        try {
          const response = await fetch(page.dataset.apiUrl, {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ token }),
          });
          if (!response.ok) throw new Error('Invalid link');
          if (mark) mark.textContent = '✓';
          if (title) title.textContent = 'You have been unsubscribed.';
          if (body) body.textContent = 'Your preference has been saved. Thank you for being part of the journey.';
          homeOnly();
        } catch {
          button.disabled = false;
          button.textContent = 'Try again';
          if (body) body.textContent = 'That link may have expired. Please try the link from your latest newsletter.';
        }
      });
    })();
  </script>
</SiteLayout>
