---
import SiteLayout from '@web/site/layouts/SiteLayout.astro';
import PageHero from '@web/site/components/PageHero.astro';
import Icon from '@web/site/components/Icon';
import FitQuiz from '@web/site/components/FitQuiz';
import Faq from '@web/site/components/Faq';
import ProgramRow from '@web/site/components/ProgramRow.astro';
import PdfPeek, { type PeekProgram } from '@web/site/components/PdfPeek';
import PeekDialog from '@web/site/components/PeekDialog';
import { href } from '@web/site/config';
import { programDisclaimer, programFaqs } from '@web/site/data';
import { loadSitePrograms, setProgramCacheHeaders } from '@web/utils/programs';
import { productName } from '@web/site/programs';
import { faqStructuredData, programsStructuredData } from '@web/site/structured-data';

// Rendered on request so programs published in the admin appear without a rebuild.
export const prerender = false;
const { programs, ok: programsLoaded } = await loadSitePrograms();
setProgramCacheHeaders(Astro.response.headers);
const { checkout } = Astro.locals;
const faqs = programFaqs(checkout);

const strength = programs.filter((p) => p.series === 'strength').sort((a, b) => (a.step ?? 0) - (b.step ?? 0));
const focus = programs.filter((p) => p.series === 'focus');
const names = programs.map((p) => p.name);
// Programs whose PDF pictures the admin has made (from the uploaded PDF), in page order.
const peekPrograms: PeekProgram[] = [...strength, ...focus].flatMap((p) => {
  const { preview } = p;
  return preview ? [{ slug: p.slug, name: p.name, tone: p.tone, illustration: p.illustration, step: p.step, volume: p.volume, summary: p.short, tags: p.tags, highlights: p.highlights, basketName: productName(p), preview }] : [];
});
const description = names.length > 1
  ? `${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}: once-off digital programs by Tilana van Tonder.`
  : 'Once-off digital strength, pelvic-floor and nutrition programs by Tilana van Tonder.';
// What search and AI answer engines read: the page, each program with its price, and the buying FAQs.
const pageUrl = new URL('/program', Astro.site).href;
const personId = new URL('/#person', Astro.site).href;
const structuredData = [
  {
    '@type': 'WebPage',
    '@id': `${pageUrl}#webpage`,
    url: pageUrl,
    name: 'Programs & Pricing | Tilana van Tonder',
    description,
    isPartOf: { '@id': new URL('/#website', Astro.site).href },
    about: { '@id': personId },
  },
  ...(programs.length ? [programsStructuredData([...strength, ...focus], pageUrl, personId, new URL('/og.png', Astro.site).href)] : []),
  faqStructuredData(faqs, pageUrl),
];
---
<SiteLayout title="Programs & Pricing" current="program" description={description} programs={programs} structuredData={structuredData}>
  <PageHero
    eyebrow="Programs for real life"
    lines={['Find your', '*next step.*']}
    intro="Start where you are and choose the support that suits you - from foundational movement and nourishment to pelvic-floor connection and progressive strength."
  >
    {programs.length > 0 && <nav class="hero-jump card" aria-label="Jump to a program" data-reveal data-reveal-delay="0.3">
      {strength.length > 0 && <p>The strength series</p>}
      {strength.length > 0 && <ol class="jump-steps">
        {strength.map((p) => (
          <li>
            <a href={`#${p.key}`}>
              <span class="pm-bars" aria-hidden="true">{[1, 2, 3].map((n) => <i class={n <= (p.step ?? 0) ? 'on' : undefined} />)}</span>
              <strong>{p.name}</strong>
              <small>{p.marker}</small>
            </a>
          </li>
        ))}
      </ol>}
      {focus.length > 0 && <p>Focus programs</p>}
      {focus.length > 0 && <ul class="jump-focus">
        {focus.map((p) => <li><a href={`#${p.key}`}><Icon name={p.icon} /><strong>{p.name}</strong><small>{p.marker}</small></a></li>)}
      </ul>}
    </nav>}
  </PageHero>

  <section class="section band" id="quiz">
    <div class="wrap quiz-grid">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Find your fit</p>
        <h2 class="h2">Not sure where <em>to start?</em></h2>
        <p class="lede">Three quick questions and you’ll have a recommendation{checkout ? ', ready to add to your basket' : ''}. Still unsure? <a href={href('/contact')}>Ask me directly</a>.</p>
      </div>
      <div data-reveal data-reveal-delay="0.1"><FitQuiz client:visible programs={programs} checkout={checkout} /></div>
    </div>
  </section>

  {programs.length === 0 && (
    <section class="section wrap">
      <div class="cta-band card prog-unavailable" data-reveal>
        <div>
          <p class="eyebrow">Programs</p>
          <h3>{programsLoaded ? 'New programs are on the way.' : 'The programs are taking a moment to load.'}</h3>
          <p>{programsLoaded ? 'Get in touch and I’ll let you know as soon as they are ready.' : 'Please refresh the page in a minute, or get in touch and I’ll help you directly.'}</p>
        </div>
        <div class="private-actions">
          <a class="btn btn-primary" href={href('/contact')}>Get in touch <Icon name="arrow" /></a>
        </div>
      </div>
    </section>
  )}

  {strength.length > 0 && <section class="section wrap" id="strength-series" aria-labelledby="series-title">
    <div class="section-head split" data-reveal>
      <div>
        <p class="eyebrow">The strength series</p>
        <h2 class="h2" id="series-title">One bar, <em>three steps.</em></h2>
      </div>
      <p class="lede">Each volume builds on the one before. When the basics feel comfortable, the next one is waiting. No rush.</p>
    </div>
    <ol class="series">
      {strength.map((p) => (
        <li class="series-step">
          <span class="series-dot" aria-hidden="true">{p.step}</span>
          <ProgramRow program={p} />
        </li>
      ))}
    </ol>
  </section>}

  {focus.length > 0 && <section class="section band" id="focus-programs" aria-labelledby="focus-title">
    <div class="wrap">
      <div class="section-head split" data-reveal>
        <div>
          <p class="eyebrow">Focus programs</p>
          <h2 class="h2" id="focus-title">Breath, body <em>&amp; plate.</em></h2>
        </div>
        <p class="lede">Stand-alone programs you can start any time, on their own or alongside the strength series.</p>
      </div>
      <div class="focus-grid">
        {focus.map((p, i) => <ProgramRow program={p} layout="stack" delay={i * 0.08} />)}
      </div>
    </div>
  </section>}


  {peekPrograms.length > 0 && <section class="section wrap" id="peek" aria-labelledby="peek-title">
    <div class="section-head split" data-reveal>
      <div>
        <p class="eyebrow">Inside the PDFs</p>
        <h2 class="h2" id="peek-title">Take a peek <em>inside.</em></h2>
      </div>
      <p class="lede">What each program covers, and real pages to flip through: the cover, then a few pages from inside. The details are blurred here and waiting in your PDF.</p>
    </div>
    <div data-reveal data-reveal-delay="0.1"><PdfPeek client:visible programs={peekPrograms} checkout={checkout} /></div>
  </section>}
  {peekPrograms.length > 0 && <PeekDialog client:idle programs={peekPrograms} checkout={checkout} />}

  <section class="wrap">
    <div class="cta-band card private-card" data-reveal>
      <div>
        <p class="eyebrow">Private training</p>
        <h3>Want to train <em>one-on-one?</em></h3>
        <p>Please contact me to discuss private training: a plan built around you, with regular check-ins along the way.</p>
      </div>
      <div class="private-actions">
        <a class="btn btn-accent" href={href('/contact?interest=one-on-one')}>Get in touch <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section wrap faq-grid">
    <div class="section-head" data-reveal>
      <p class="eyebrow">Buying a program</p>
      <h2 class="h2">Good to <em>know.</em></h2>
      <p class="lede">The <a href={href('/terms')}>terms of sale</a>, <a href={href('/refund-policy')}>refund policy</a> and <a href={href('/privacy')}>privacy policy</a> have the full details.</p>
    </div>
    <div data-reveal data-reveal-delay="0.1"><Faq client:visible items={faqs} /></div>
  </section>

  <section class="wrap">
    <div class="disclaimer card" data-reveal>
      <strong>Important</strong>
      <p>{programDisclaimer}</p>
    </div>
  </section>
</SiteLayout>
