---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '@tilana/ui-astro/PageHero.astro';
import { formatZar, programmeCatalogByKey } from '@tilana/contracts/programs';
import { marketingPrograms } from '../data/programs';

const programs = marketingPrograms.map((program) => {
  const priceCents = program.displayPriceCents ?? (
    program.catalogueKey
      ? programmeCatalogByKey[program.catalogueKey].suggestedPriceCents
      : null
  );

  return {
    ...program,
    price: priceCents !== null ? formatZar(priceCents) : null,
    salePrice: priceCents !== null ? formatZar(Math.round(priceCents * 70 / 10_000) * 100) : null,
  };
});
---

<BaseLayout title="Programs & Pricing" description="Explore Beginner, Intermediate, Advanced, Reconnect and Nourish programs from Tilana van Tonder.">
  <PageHero eyebrow="Programs for real life" title="Find your" script="next step." intro="Start where you are and choose the support that suits you - from foundational movement and nourishment to pelvic-floor connection and progressive strength." />
  <section id="program-collection" class="section program-collection">
    <div class="container">
      <div class="program-toolbar">
        <div><p class="eyebrow">The program collection</p><h2 class="heading-lg">Explore at your own pace.</h2></div>
        <div class="rail-nav" aria-label="Program carousel controls">
          <button type="button" class="rail-btn" data-program-prev aria-label="Previous programs" aria-controls="program-rail" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 8 12l7 7"/></svg></button>
          <button type="button" class="rail-btn" data-program-next aria-label="Next programs" aria-controls="program-rail"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
        </div>
      </div>
      <div id="program-rail" class="program-grid" data-program-rail tabindex="0" aria-label="Programs">
        {programs.map((program) => (
          <article class:list={['card', 'program-tile', `program-${program.accent}`]}>
            <div class="tile-top">
              <span class="badge">{program.label}</span>
            </div>
            <div class="program-copy">
              <p class="program-level">{program.name}</p>
              <h2>{program.title}</h2>
              <p>{program.description}</p>
            </div>
            {program.price && (
              <div class="program-footer">
                <div class="program-price">
                  <span class="sale-badge">30% OFF</span>
                  <span>Once-off</span>
                  <div class="price-pair">
                    <del aria-label={`Original price ${program.price}`}>{program.price}</del>
                    <strong aria-label={`Sale price ${program.salePrice}`}>{program.salePrice}</strong>
                  </div>
                  <p class="sale-offer">2-4 October 2026 only</p>
                </div>
                {program.interest && <a class="button button-secondary" href={`/contact?interest=${program.interest}${program.enquiryMessage ? `&message=${encodeURIComponent(program.enquiryMessage)}` : ''}`}>Ask about {program.name}</a>}
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="safety"><div class="container"><strong>Important:</strong> All programs provide general education based on personal experience and are not a substitute for medical, physiotherapy, dietetic, or other qualified professional care. Seek appropriate clearance before beginning, particularly during pregnancy, after birth, or when managing an injury or health condition. Stop and consult an appropriately qualified healthcare professional if movement causes pain, dizziness, unusual shortness of breath, pelvic-floor symptoms, or other concerns.</div></section>
</BaseLayout>

<style>
  .program-collection { --sale-accent: #43583d; --sale-pastel: #dce5ce; scroll-margin-top: 6.5rem; background: var(--cream); }
  :global(.dark) .program-collection { --sale-accent: #dce5ce; --sale-pastel: #35412f; }
  .program-toolbar { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; margin-bottom: 2.5rem; }
  .program-toolbar .heading-lg { font-size: clamp(2rem, 4vw, 3.5rem); }
  .rail-nav { display: flex; gap: 0.65rem; flex: none; }
  .rail-btn { display: grid; width: 3.25rem; height: 3.25rem; place-items: center; padding: 0; border: 1px solid var(--color-border); border-radius: 50%; color: var(--ink); background: color-mix(in srgb, var(--white) 82%, var(--cream)); cursor: pointer; transition: color var(--motion-fast) ease, background-color var(--motion-fast) ease, border-color var(--motion-fast) ease, box-shadow var(--motion-fast) ease, transform var(--motion-fast) ease, opacity var(--motion-fast) ease; }
  .rail-btn svg { width: 1.3rem; height: 1.3rem; fill: none; stroke: currentColor; stroke-width: 2.25; stroke-linecap: round; stroke-linejoin: round; }
  .rail-btn:hover:not(:disabled) { border-color: var(--caramel); color: var(--color-on-primary); background: var(--caramel); box-shadow: var(--shadow-sm); transform: translateY(-2px); }
  .rail-btn:disabled { opacity: 0.32; cursor: default; }
  /* Let card shadows fade inside the scroll area while preserving the section spacing. */
  .program-grid { display: grid; gap: 1.25rem; grid-auto-columns: clamp(20rem, 26vw, 24rem); grid-auto-flow: column; overflow-x: auto; overscroll-behavior-inline: contain; margin: -2.6rem -1.5rem -4.75rem; padding: 3rem 1.5rem 6rem; scroll-padding-inline: 1.5rem; scroll-snap-type: x mandatory; scrollbar-width: none; -ms-overflow-style: none; -webkit-overflow-scrolling: touch; }
  .program-grid::-webkit-scrollbar { display: none; }
  .program-tile { display: flex; min-height: 38rem; flex-direction: column; padding: clamp(1.7rem, 2.5vw, 2.15rem); scroll-snap-align: start; }
  .tile-top { display: flex; min-height: 4.5rem; align-items: flex-start; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap; }
  .program-copy { margin-top: 1.5rem; }
  .program-level { margin: 0 0 0.65rem; color: var(--caramel); font-size: 0.68rem; font-weight: 750; letter-spacing: 0.12em; text-transform: uppercase; }
  .program-tile h2 { margin: 0 0 1.2rem; color: var(--ink); font-family: var(--font-heading); font-size: clamp(2rem, 3vw, 2.65rem); line-height: 1.04; }
  .program-copy > p:last-child { margin: 0; font-size: 0.92rem; line-height: 1.75; }
  .program-footer { margin-top: auto; padding-top: 2rem; }
  .program-price { display: grid; gap: 0.2rem; margin-bottom: 1.1rem; padding: 1rem; border: 1px solid color-mix(in srgb, var(--sale-accent) 22%, transparent); border-radius: var(--radius-md); background: color-mix(in srgb, var(--sale-pastel) 70%, var(--white)); }
  .program-price span { color: var(--caramel); font-size: 0.64rem; font-weight: 750; letter-spacing: 0.1em; text-transform: uppercase; }
  .program-price strong { color: var(--sale-accent); font-family: var(--font-heading); font-size: clamp(2.3rem, 3.2vw, 2.65rem); font-weight: 700; line-height: 1; }
  .program-price .sale-badge { justify-self: start; margin-bottom: 0.6rem; padding: 0.45rem 0.75rem; border: 1px solid #b6c6a3; border-radius: var(--radius-pill); color: #35462f; background: #c9d8b7; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.08em; box-shadow: 0 4px 12px rgb(67 88 61 / 12%); }
  .price-pair { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.75rem; margin-block: 0.35rem; }
  .price-pair del { color: var(--color-text-muted); font-size: 1.05rem; }
  .program-price .sale-offer { margin: 0.2rem 0 0; color: var(--sale-accent); font-size: 0.75rem; font-weight: 700; line-height: 1.5; }
  .program-tile .button { width: 100%; padding-inline: 0.8rem; }
  .program-beginner { --card-accent: var(--terracotta); }
  .program-intermediate { --card-accent: var(--sage); }
  .program-advanced { --card-accent: var(--caramel); }
  .program-reconnect { --card-accent: var(--terracotta); }
  .program-nourish { --card-accent: var(--sage); }
  .safety { padding-block: 2rem; color: var(--ink); background: var(--sage); font-size: 0.8rem; line-height: 1.6; }
  @media (max-width: 72rem) { .program-grid { grid-auto-columns: minmax(19rem, 42vw); } }
  @media (max-width: 48rem) { .program-toolbar { align-items: center; gap: 1rem; } .program-toolbar .heading-lg { font-size: clamp(1.8rem, 8vw, 2.6rem); } .rail-btn { width: 2.75rem; height: 2.75rem; } .program-grid { grid-auto-columns: minmax(18rem, 86vw); } .program-tile { min-height: 36rem; } }
  @media (max-width: 30rem) { .program-toolbar .eyebrow { display: none; } }
</style>

<script>
  const programRail = document.querySelector<HTMLElement>('[data-program-rail]');
  const programPrev = document.querySelector<HTMLButtonElement>('[data-program-prev]');
  const programNext = document.querySelector<HTMLButtonElement>('[data-program-next]');

  if (programRail && programPrev && programNext) {
    const scrollStep = () => {
      const card = programRail.querySelector<HTMLElement>('.program-tile');
      const gap = Number.parseFloat(getComputedStyle(programRail).columnGap || '20') || 20;
      return card ? card.offsetWidth + gap : programRail.clientWidth * 0.85;
    };

    const syncControls = () => {
      const maxScroll = Math.max(0, programRail.scrollWidth - programRail.clientWidth - 1);
      programPrev.disabled = programRail.scrollLeft <= 1;
      programNext.disabled = programRail.scrollLeft >= maxScroll;
    };

    const scrollBehavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    programPrev.addEventListener('click', () => programRail.scrollBy({ left: -scrollStep(), behavior: scrollBehavior }));
    programNext.addEventListener('click', () => programRail.scrollBy({ left: scrollStep(), behavior: scrollBehavior }));
    programRail.addEventListener('scroll', syncControls, { passive: true });
    window.addEventListener('resize', syncControls);
    syncControls();
  }
</script>
