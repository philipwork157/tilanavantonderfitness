---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '@tilana/ui-astro/PageHero.astro';
import { formatZar, programmeCatalogByKey } from '@tilana/contracts/programs';
import { marketingPrograms } from '../data/programs';

const programs = marketingPrograms.map((program) => ({
  ...program,
  price:
    program.catalogueKey && !program.status
      ? formatZar(programmeCatalogByKey[program.catalogueKey].suggestedPriceCents)
      : null,
}));
---

<BaseLayout title="Programs & Pricing" description="Explore Beginner, Reconnect and Nourish programs from Tilana van Tonder, with Intermediate and Advanced strength programs coming soon.">
  <PageHero eyebrow="Programs for real life" title="Find your" script="next step." intro="Start where you are and choose the support that suits you—from foundational movement and nourishment to pelvic-floor connection and progressive strength." />
  <section class="section program-collection">
    <div class="container">
      <div class="program-grid">
        {programs.map((program) => (
          <article class:list={['card', 'program-tile', `program-${program.accent}`]}>
            <div class="tile-top">
              <span class="badge">{program.label}</span>
              {'status' in program && <span class="status">{program.status}</span>}
            </div>
            <div class="program-copy">
              <p class="program-level">{program.name}</p>
              <h2>{program.title}</h2>
              <p>{program.description}</p>
            </div>
            {program.price && program.interest && (
              <div class="program-footer">
                <div class="program-price"><span>Once-off</span><strong>{program.price}</strong></div>
                <a class="button button-secondary" href={`/contact?interest=${program.interest}`}>Ask about {program.name}</a>
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="safety"><div class="container"><strong>Important:</strong> All programs provide general education based on personal experience and are not a substitute for medical, physiotherapy, dietetic, or other qualified professional care. Seek appropriate clearance before beginning, particularly during pregnancy, after birth, or when managing an injury or health condition. Stop and consult an appropriately qualified healthcare professional if movement causes pain, dizziness, unusual shortness of breath, pelvic-floor symptoms, or other concerns.</div></section>
</BaseLayout>

<style>
  .program-collection { background: var(--cream); }
  .program-grid { display: grid; gap: 1rem; grid-auto-flow: column; grid-template-columns: repeat(5, minmax(13.5rem, 1fr)); overflow-x: auto; overscroll-behavior-inline: contain; padding: 0.4rem 0 1.2rem; scroll-snap-type: x proximity; scrollbar-width: thin; -webkit-overflow-scrolling: touch; }
  .program-tile { display: flex; min-height: 36rem; flex-direction: column; padding: 1.5rem; scroll-snap-align: start; }
  .tile-top { display: flex; min-height: 4.5rem; align-items: flex-start; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap; }
  .status { padding: 0.45rem 0.65rem; border-radius: 999px; color: var(--ink); background: color-mix(in srgb, var(--cream) 70%, transparent); font-size: 0.62rem; font-weight: 750; letter-spacing: 0.08em; text-transform: uppercase; }
  .program-copy { margin-top: 1.5rem; }
  .program-level { margin: 0 0 0.65rem; color: var(--caramel); font-size: 0.68rem; font-weight: 750; letter-spacing: 0.12em; text-transform: uppercase; }
  .program-tile h2 { margin: 0 0 1rem; color: var(--ink); font-family: var(--font-heading); font-size: clamp(1.6rem, 2vw, 2.15rem); line-height: 1.05; }
  .program-copy > p:last-child { margin: 0; font-size: 0.8rem; }
  .program-footer { margin-top: auto; padding-top: 2rem; }
  .program-price { display: grid; gap: 0.2rem; margin-bottom: 1.1rem; }
  .program-price span { color: var(--caramel); font-size: 0.64rem; font-weight: 750; letter-spacing: 0.1em; text-transform: uppercase; }
  .program-price strong { color: var(--ink); font-family: var(--font-heading); font-size: 2rem; line-height: 1; }
  .program-tile .button { width: 100%; padding-inline: 0.8rem; }
  .program-beginner { --card-accent: var(--terracotta); }
  .program-intermediate { --card-accent: var(--sage); }
  .program-advanced { --card-accent: var(--caramel); }
  .program-reconnect { --card-accent: var(--terracotta); }
  .program-nourish { --card-accent: var(--sage); }
  .safety { padding-block: 2rem; color: var(--ink); background: var(--sage); font-size: 0.8rem; line-height: 1.6; }
  @media (max-width: 72rem) { .program-grid { grid-auto-columns: minmax(17rem, 34vw); grid-template-columns: none; } }
  @media (max-width: 48rem) { .program-grid { grid-auto-columns: minmax(17rem, 84vw); } .program-tile { min-height: 34rem; } }
</style>
