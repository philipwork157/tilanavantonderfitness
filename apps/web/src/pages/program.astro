---
import PageHero from '@tilana/ui-astro/PageHero.astro';
import ProgramCatalogue from '../components/ProgramCatalogue.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Programs & Pricing" description="Explore Tilana van Tonder's currently available movement, strength, nourishment and pelvic-floor programs.">
  <PageHero eyebrow="Programs for real life" title="Find your" script="next step." intro="Start where you are and choose the support that suits you—from foundational movement and nourishment to pelvic-floor connection and progressive strength." />
  <ProgramCatalogue />
  <section class="safety"><div class="container"><strong>Important:</strong> All programs provide general education based on personal experience and are not a substitute for medical, physiotherapy, dietetic, or other qualified professional care. Seek appropriate clearance before beginning, particularly during pregnancy, after birth, or when managing an injury or health condition. Stop and consult an appropriately qualified healthcare professional if movement causes pain, dizziness, unusual shortness of breath, pelvic-floor symptoms, or other concerns.</div></section>
</BaseLayout>

<style>
  .safety { padding-block: 2rem; color: var(--ink); background: var(--sage); font-size: 0.8rem; line-height: 1.6; }
</style>
