---
import SiteLayout from '@web/site/layouts/SiteLayout.astro';
import PageHero from '@web/site/components/PageHero.astro';
import ContactForm from '@web/site/components/ContactForm';
import Icon from '@web/site/components/Icon';
import { href, site } from '@web/site/config';
import { contactInterests } from '@web/site/data';
---
<SiteLayout title="Contact" current="contact" newsletter={false} description="Contact Tilana van Tonder about her programs or one-on-one training.">
  <PageHero
    eyebrow="Get in touch"
    lines={['Let’s find', 'the *right fit.*']}
    intro="Tell me a little about what you're looking for. I'll reply honestly, even if a qualified healthcare professional is the better next step."
  />
  <section class="section wrap contact-grid">
    <div class="contact-side" data-reveal>
      <p class="eyebrow">Contact details</p>
      <h2 class="h2">A personal reply, <em>without the pressure.</em></h2>
      <p class="lede">Email is the simplest way to reach me. Please do not send diagnoses, medical records, or other sensitive health information.</p>
      <a class="contact-mail" href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a>
      <dl class="contact-details">
        <div>
          <dt>Buying a program</dt>
          <dd><a href={href('/terms')}>Terms of sale</a> · <a href={href('/refund-policy')}>Refund policy</a> · <a href={href('/privacy')}>Privacy policy</a></dd>
        </div>
      </dl>
      <div class="note card tone-sage">
        <strong>Not a clinical service</strong>
        <p>For medical concerns, pain, leaking, pelvic pressure, birth complications, or emergencies, contact an appropriately qualified healthcare professional.</p>
      </div>
    </div>
    <div><ContactForm client:load options={contactInterests} privacyHref={href('/privacy')} /></div>
  </section>
</SiteLayout>
