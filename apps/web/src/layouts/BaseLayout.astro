---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppLink from '../components/WhatsAppLink.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  imageAlt?: string;
  pageType?: 'website' | 'article';
  publishedAt?: Date;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  showNewsletter?: boolean;
  robots?: string;
}

const {
  title = site.name,
  description = site.description,
  image = '/og.png',
  imageAlt = 'Tilana van Tonder - strength, movement, and sustainable healthy habits',
  pageType = 'website',
  publishedAt,
  structuredData,
  showNewsletter = true,
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
} = Astro.props;
const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = image ? new URL(image, Astro.site) : null;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const websiteId = new URL('/#website', Astro.site).href;
const personId = new URL('/#person', Astro.site).href;
const pageId = `${canonical.href}#webpage`;
const extraStructuredData = structuredData
  ? Array.isArray(structuredData) ? structuredData : [structuredData]
  : [{
      '@type': 'WebPage',
      '@id': pageId,
      url: canonical.href,
      name: pageTitle,
      description,
      isPartOf: { '@id': websiteId },
      about: { '@id': personId },
    }];
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: Astro.site,
      name: site.name,
      description: site.description,
      inLanguage: 'en-ZA',
      publisher: { '@id': personId },
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: site.name,
      url: Astro.site,
      image: new URL('/tilana-home.jpg', Astro.site).href,
      description: site.description,
    },
    ...extraStructuredData,
  ],
};
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let storedTheme;

        try {
          storedTheme = localStorage.getItem('tilana-theme');
        } catch {
          storedTheme = null;
        }

        const theme = storedTheme === 'light' || storedTheme === 'dark'
          ? storedTheme
          : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';

        root.classList.toggle('dark', theme === 'dark');
        root.dataset.theme = theme;
        root.style.colorScheme = theme;
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={site.name} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#F6E4D9" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={pageType} />
    <meta property="og:locale" content="en_ZA" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:width" content="1731" />}
    {socialImage && <meta property="og:image:height" content="909" />}
    {socialImage && <meta property="og:image:type" content="image/png" />}
    {socialImage && <meta property="og:image:alt" content={imageAlt} />}
    {pageType === 'article' && publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {pageType === 'article' && <meta property="article:author" content={site.name} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImage && <meta name="twitter:image:alt" content={imageAlt} />}
    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    {showNewsletter && <NewsletterSignup />}
    <Footer />
    <WhatsAppLink />
    {turnstileSiteKey && (
      <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    )}
    <script is:inline>
      (() => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const selectors = [
          '[data-reveal]',
          '.card',
          '.value-grid article',
          '.phase-grid article',
          '.post-grid article',
          '.program-card',
          '.cover',
          'form',
        ].join(',');
        const items = [...document.querySelectorAll(selectors)];
        if (!items.length) return;

        items.forEach((item) => {
          item.setAttribute('data-reveal', '');
          const siblings = [...(item.parentElement?.children ?? [])];
          const siblingIndex = Math.max(0, siblings.indexOf(item));
          item.style.setProperty('--reveal-delay', `${Math.min(siblingIndex * 80, 240)}ms`);
          if (item.getBoundingClientRect().top < window.innerHeight * 0.92) item.classList.add('is-visible');
        });

        document.documentElement.classList.add('motion-ready');
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });

        items.filter((item) => !item.classList.contains('is-visible')).forEach((item) => observer.observe(item));
      })();
    </script>
  </body>
</html>
