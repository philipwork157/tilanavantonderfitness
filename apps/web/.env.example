# ─────────────────────────────────────────────────────────────────────────────
# Copy to apps/web/.env. Website (Astro) settings. Everything here is PUBLIC: it ends up in the
# browser. Never put secrets here (R2, Supabase, AWS or Paystack keys belong in
# apps/admin-next/.env.local). Restart `pnpm dev` after changes.
# ─────────────────────────────────────────────────────────────────────────────

# ── Admin API ────────────────────────────────────────────────────────────────
# Where the website gets programs and blog posts, and sends the contact form,
# newsletter sign-ups and checkout. Point it at the Next.js admin
# (apps/admin-next, port 3002 in development). Origin only, no path.
PUBLIC_API_BASE_URL=http://localhost:3002

# ── Spam protection ──────────────────────────────────────────────────────────
# Cloudflare Turnstile SITE key (the public half; the secret is in the admin).
# Shows the "I'm human" check on the contact, newsletter and checkout forms.
PUBLIC_TURNSTILE_SITE_KEY=REPLACE_WITH_CLOUDFLARE_TURNSTILE_SITE_KEY

# ── Product analytics (PostHog, cookieless) ──────────────────────────────────
# Project API key (starts with phc_, public; safe in the browser) from PostHog
# → Project settings. Leave empty to turn analytics off. The host must match the
# project's region: https://eu.i.posthog.com (EU) or https://us.i.posthog.com.
# In PostHog → Project settings, switch on "Cookieless server hash mode" (or no
# events are kept) and "Discard client IP data" (the privacy policy says IP
# addresses are not stored).
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Labels visits for the admin's Website page: "development" or "production".
# Leave empty locally (localhost counts as development); the deploy workflows set it.
PUBLIC_SITE_ENVIRONMENT=
