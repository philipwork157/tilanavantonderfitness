# Copy this file to apps/web/.env. These values are intentionally public browser settings.
# Cloudflare R2 credentials belong only in apps/admin/.env and must never be
# added here. The public website will consume safe catalogue media URLs only.

PUBLIC_TURNSTILE_SITE_KEY=REPLACE_WITH_CLOUDFLARE_TURNSTILE_SITE_KEY

# Shared admin/API origin. Application endpoint paths are derived in code.
PUBLIC_API_BASE_URL=http://127.0.0.1:3001
