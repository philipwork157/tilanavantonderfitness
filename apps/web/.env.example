# ─────────────────────────────────────────────────────────────────────────────
# Copy to apps/web/.env. Website (Astro) settings. Everything here is PUBLIC: it ends up in the
# browser. Never put secrets here (R2, Supabase, AWS or Paystack keys belong in
# apps/admin-next/.env.local). Restart `pnpm dev` after changes.
# ─────────────────────────────────────────────────────────────────────────────

# ── Admin API ────────────────────────────────────────────────────────────────
# Where the website gets programs and blog posts, and sends the contact form,
# newsletter sign-ups and checkout. Point it at the Next.js admin
# (apps/admin-next, port 3002 in development). Origin only, no path.
PUBLIC_API_BASE_URL=http://localhost:3002

# ── Spam protection ──────────────────────────────────────────────────────────
# Cloudflare Turnstile SITE key (the public half; the secret is in the admin).
# Shows the "I'm human" check on the contact, newsletter and checkout forms.
PUBLIC_TURNSTILE_SITE_KEY=REPLACE_WITH_CLOUDFLARE_TURNSTILE_SITE_KEY
