{
  "name": "@tilana/web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host localhost --port 4321",
    "start": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host localhost --port 4321",
    "build": "pnpm typecheck && astro build",
    "preview": "wrangler dev --config dist/server/wrangler.json",
    "lint": "eslint \"src/**/*.{astro,js,ts,tsx}\" \"scripts/**/*.mjs\" \"tests/**/*.ts\" \"*.{js,mjs,ts}\" --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "astro check",
    "check": "pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.3",
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/allura": "^5.3.0",
    "@tilana/content": "workspace:*",
    "@tilana/contracts": "workspace:*",
    "astro": "7.3.5",
    "motion": "^14.0.0",
    "posthog-js": "1.434.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.11.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^5.0.0",
    "wrangler": "4.147.0"
  }
}
