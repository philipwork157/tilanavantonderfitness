{
  "name": "@tilana/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NUXT_TELEMETRY_DISABLED=1 nuxt dev --dotenv ../../.env --host localhost --port 3001",
    "build": "nuxt build --dotenv ../../.env",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "nuxt typecheck --dotenv ../../.env",
    "prepare": "nuxt prepare --dotenv ../../.env",
    "postinstall": "nuxt prepare --dotenv ../../.env",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "@tilana/contracts": "workspace:*",
    "@tilana/ui-nuxt": "workspace:*",
    "nuxt": "4.5.2"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.137",
    "@nuxt/eslint": "1.17.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.8.1",
    "typescript": "6.0.3",
    "vitest": "5.0.0",
    "vue-tsc": "3.3.11"
  }
}
