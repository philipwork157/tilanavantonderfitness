# Copy to apps/admin/.env (never committed). Add only settings for implemented features.
# The public website uses apps/web/.env and its own .env.example.

# Admin sign-in (Supabase Auth). Use the project URL and the publishable (anon) key.
NUXT_SUPABASE_URL=
NUXT_SUPABASE_PUBLISHABLE_KEY=

# Postgres connection string for the DEVELOPMENT database (Supabase > Connect > Session pooler).
# Used by the admin and by pnpm db:migrate / pnpm db:add-admin from the repo root.
NUXT_DATABASE_URL=
