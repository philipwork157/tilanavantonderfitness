# Copy to apps/admin/.env (never committed). Add only settings for implemented features.
# The public website uses apps/web/.env and its own .env.example.

# Admin sign-in (Supabase Auth). Use the project URL and the publishable (anon) key.
NUXT_SUPABASE_URL=
NUXT_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret (Supabase > Settings > API). Used to store blog photos.
NUXT_SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for the DEVELOPMENT database (Supabase > Connect > Session pooler).
# Used by the admin and by pnpm db:migrate / pnpm db:add-admin from the repo root.
NUXT_DATABASE_URL=

# Email via Amazon SES (the AWS SDK reads these three).
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Verified SES sender.
NUXT_EMAIL_FROM_ADDRESS=
NUXT_EMAIL_FROM_NAME=Tilana van Tonder website
# DEVELOPMENT ONLY: every outgoing email is sent here instead (required in dev).
# Leave unset in production.
NUXT_EMAIL_DEV_REDIRECT_TO=

# Contact form: who receives new enquiries, Turnstile secret, allowed website origins.
NUXT_CONTACT_NOTIFY_TO=
NUXT_TURNSTILE_SECRET_KEY=
NUXT_WEBSITE_ORIGINS=http://localhost:4321

# Public website address used in email links (no trailing slash).
NUXT_WEBSITE_URL=http://localhost:4321

# Newsletter: who receives test emails before a campaign is sent (comma separated).
NUXT_NEWSLETTER_TEST_TO=
# Amazon SNS topic ARN for SES bounce and complaint reports (POST /api/webhooks/ses).
# Leave empty until the SNS subscription is set up; the webhook is off without it.
NUXT_SES_EVENTS_TOPIC_ARN=
