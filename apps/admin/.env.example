# Copy this file to apps/admin/.env. Never commit the real file.

# Supabase transaction-pooler connection used only by Nuxt/Drizzle on the server.
NUXT_DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:6543/postgres

# Optional direct connection for Drizzle migrations. Prefer passing this as
# DATABASE_URL in CI/deployment instead of storing another credential locally.
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Reserved for Supabase Auth and Storage in the next admin phase. This key is server-only.
NUXT_SUPABASE_URL=https://PROJECT_REF.supabase.co
# Safe public/publishable key used for user authentication. This is not the service-role key.
NUXT_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY
NUXT_SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY

# Origins allowed to call POST /api/contact.
NUXT_CONTACT_ALLOWED_ORIGINS=http://127.0.0.1:4321,http://localhost:4321,https://tilanavantonder.co.za,https://www.tilanavantonder.co.za

# Cloudflare Turnstile. Keep the secret server-only and use a long random IP-hash secret.
NUXT_TURNSTILE_SECRET_KEY=REPLACE_WITH_CLOUDFLARE_TURNSTILE_SECRET
NUXT_CONTACT_IP_HASH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
NUXT_CONTACT_TURNSTILE_REQUIRED=true

# AWS SES notification sent to Tilana after the enquiry is stored. The sender
# address/domain must be verified in the same SES region. Use an IAM role in
# production where possible; these standard AWS variables are for local or
# non-AWS hosting environments.
NUXT_CONTACT_NOTIFICATION_ENABLED=true
NUXT_CONTACT_NOTIFICATION_TO=tilanavantonder@gmail.com
NUXT_EMAIL_FROM_ADDRESS=website@tilanavantonder.co.za
NUXT_EMAIL_FROM_NAME=Tilana van Tonder website
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_SES_ONLY_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SES_ONLY_SECRET_KEY
# AWS_SESSION_TOKEN=ONLY_REQUIRED_FOR_TEMPORARY_CREDENTIALS

# Newsletter double opt-in. The sender/domain must be verified in AWS SES.
NUXT_NEWSLETTER_FROM_EMAIL=newsletter@tilanavantonder.co.za
# Development safety: all newsletter emails are redirected here instead of
# being delivered to the subscriber. This is ignored in production.
NUXT_NEWSLETTER_DEVELOPMENT_RECIPIENT=tilanavantonder@gmail.com
NUXT_NEWSLETTER_API_BASE_URL=https://admin.tilanavantonder.co.za
NUXT_NEWSLETTER_SITE_URL=https://tilanavantonder.co.za

# Optional delivery guard: local and Fly dev customer access links are sent here
# while still authenticating as the intended test customer. Production ignores it.
NUXT_CUSTOMER_ACCESS_DEVELOPMENT_RECIPIENT=tilanavantonder@gmail.com

# Paystack checkout. Keep the secret key on the Nuxt server only.
NUXT_PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_PAYSTACK_SECRET_KEY
NUXT_PAYSTACK_ENVIRONMENT=test
NUXT_PAYSTACK_CALLBACK_URL=https://tilanavantonder.co.za/checkout/complete
NUXT_ACCOUNT_BASE_URL=https://admin.tilanavantonder.co.za

# Read-only Cloudflare R2 API credentials for short-lived customer downloads.
NUXT_R2_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
NUXT_R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
NUXT_R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
