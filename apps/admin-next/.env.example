# Copy to apps/admin-next/.env.local (never committed). Add only settings for
# implemented features. `pnpm db:*` commands read DATABASE_URL from here too.

# Supabase Auth: project URL and the publishable (anon) key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Postgres connection string for the DEVELOPMENT database (Supabase > Connect > Session pooler).
DATABASE_URL=

# Email via Amazon SES (the AWS SDK reads these three).
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Verified SES sender.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Tilana van Tonder website
# DEVELOPMENT ONLY: every outgoing email is sent here instead (required in dev).
# Leave unset in production.
EMAIL_DEV_REDIRECT_TO=

# Contact form: who receives new enquiries, Turnstile secret, allowed website origins.
CONTACT_NOTIFY_TO=
TURNSTILE_SECRET_KEY=
WEBSITE_ORIGINS=http://localhost:4321

# Public website address used in email links (no trailing slash).
WEBSITE_URL=http://localhost:4321

# Newsletter: who receives test emails before a campaign is sent (comma separated).
NEWSLETTER_TEST_TO=
# Amazon SNS topic ARN for SES bounce and complaint reports (POST /api/webhooks/ses).
# Leave empty until the SNS subscription is set up; the webhook is off without it.
SES_EVENTS_TOPIC_ARN=


# Cloudflare R2: two buckets per environment, never shared between dev and prod.
#
# Program PDFs: the PRIVATE bucket (public access off), e.g.
# tilanavantonder-dev-private for development.
R2_ACCOUNT_ID=
R2_PRIVATE_PROGRAM_BUCKET=
# R2 API token with "Object Read & Write" on that bucket only (used for uploads).
R2_UPLOAD_ACCESS_KEY_ID=
R2_UPLOAD_SECRET_ACCESS_KEY=
# R2 API token with "Object Read only" on that bucket only (used to attach PDFs to emails).
R2_DOWNLOAD_ACCESS_KEY_ID=
R2_DOWNLOAD_SECRET_ACCESS_KEY=

# Website pictures (blog covers, Kitchen photos, program "Peek inside" pages):
# the PUBLIC bucket, e.g. tilanavantonder-dev-public, connected to a custom
# domain in the bucket's Settings > Custom Domains. R2_PUBLIC_URL is that
# address, e.g. https://media-dev.tilanavantonder.co.za. Never the PDF bucket.
R2_PUBLIC_BUCKET=
R2_PUBLIC_URL=
# R2 API token with "Object Read & Write" on the public bucket only.
R2_PUBLIC_ACCESS_KEY_ID=
R2_PUBLIC_SECRET_ACCESS_KEY=

# Paystack payments (Paystack > Settings > API Keys & Webhooks). Server only.
# Development uses the TEST secret key (sk_test_...) with PAYSTACK_MODE=test;
# production uses sk_live_... with PAYSTACK_MODE=live. A mismatch stops checkout.
# Webhook URL to set in Paystack: <admin address>/api/webhooks/paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_MODE=test

# Background order checks run every 5 minutes inside the admin server
# (unconfirmed payments, PDF email retries, pending refunds). On hosts that
# stop the server between requests (e.g. Vercel), schedule
# GET /api/cron/order-checks every 5 minutes with
# "Authorization: Bearer <CRON_SECRET>" instead. Empty = that URL is off.
CRON_SECRET=

# Logging: one line per API request (method, path, status, time, request ID,
# masked IP and the signed-in admin). Readable lines in development, JSON in
# production. Optional: trace, debug, info, warn, error or silent.
# Default: debug in development, info in production.
LOG_LEVEL=

# PostHog (website analytics on the admin's Website page). Server only: never
# expose these to the browser. Create the key in PostHog → Settings → Personal
# API keys, limited to this project with only "Query: Read". It starts with phx_.
# Project ID is in PostHog → Project settings (or the address bar). The host is
# the app address for the project's region (https://eu.posthog.com or
# https://us.posthog.com), not the i.posthog.com address the website sends to.
# Leave the key empty to hide the visitor numbers.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://eu.posthog.com
