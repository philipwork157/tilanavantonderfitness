# Copy to apps/admin-next/.env.local (never committed). Same values as
# apps/admin/.env, without the NUXT_ prefix. Add only settings for implemented features.

# Supabase Auth: project URL and the publishable (anon) key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret (Supabase > Settings > API). Used to store blog photos.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for the DEVELOPMENT database (Supabase > Connect > Session pooler).
DATABASE_URL=

# Email via Amazon SES (the AWS SDK reads these three).
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Verified SES sender.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Tilana van Tonder website
# DEVELOPMENT ONLY: every outgoing email is sent here instead (required in dev).
# Leave unset in production.
EMAIL_DEV_REDIRECT_TO=

# Contact form: who receives new enquiries, Turnstile secret, allowed website origins.
CONTACT_NOTIFY_TO=
TURNSTILE_SECRET_KEY=
WEBSITE_ORIGINS=http://localhost:4321

# Public website address used in email links (no trailing slash).
WEBSITE_URL=http://localhost:4321

# Newsletter: who receives test emails before a campaign is sent (comma separated).
NEWSLETTER_TEST_TO=
# Amazon SNS topic ARN for SES bounce and complaint reports (POST /api/webhooks/ses).
# Leave empty until the SNS subscription is set up; the webhook is off without it.
SES_EVENTS_TOPIC_ARN=


# Program PDFs: a PRIVATE Cloudflare R2 bucket (Cloudflare > R2). Same values as the old
# admin's NUXT_R2_* settings. Use one bucket per environment, e.g.
# tilanavantonder-dev-private-programs for development.
R2_ACCOUNT_ID=
R2_PRIVATE_PROGRAM_BUCKET=
# R2 API token with "Object Read & Write" on that bucket only (used for uploads).
R2_UPLOAD_ACCESS_KEY_ID=
R2_UPLOAD_SECRET_ACCESS_KEY=
# R2 API token with "Object Read only" on that bucket only (used to attach PDFs to emails).
R2_DOWNLOAD_ACCESS_KEY_ID=
R2_DOWNLOAD_SECRET_ACCESS_KEY=
