{
  "name": "@tilana/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./schema": "./src/schema/index.ts",
    "./server": "./src/server.ts",
    "./types": "./src/types/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node ./src/scripts/migrate.ts",
    "db:apply": "pnpm db:generate && pnpm db:migrate",
    "db:check": "drizzle-kit check",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tilana/contracts": "workspace:*",
    "drizzle-orm": "latest",
    "postgres": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "drizzle-kit": "latest",
    "eslint": "^10.8.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.67.0"
  }
}
