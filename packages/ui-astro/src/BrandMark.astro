---
interface Props {
  name: string;
  href?: string;
  variant?: 'header' | 'footer';
  ariaLabel?: string;
}

const {
  name,
  href = '/',
  variant = 'header',
  ariaLabel,
} = Astro.props;
---

<a class:list={['brand-mark', variant]} href={href} aria-label={ariaLabel}>{name}</a>

<style>
  .brand-mark {
    display: inline-block;
    font-family: var(--font-script);
    line-height: 1;
    transition: color 220ms ease, transform 220ms ease;
  }

  .brand-mark:hover {
    transform: translateY(-2px) rotate(-1deg);
  }

  .header {
    color: var(--caramel);
    font-size: clamp(2rem, 3vw, 2.5rem);
  }

  .header:hover {
    color: var(--chocolate);
  }

  .footer {
    color: var(--terracotta);
    font-size: 2.7rem;
  }

  .footer:hover {
    color: var(--cream);
  }
</style>
