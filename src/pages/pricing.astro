---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---
<BaseLayout title="Pricing" description="Simple pricing for the Strong Again self-guided program and optional accountability support.">
  <PageHero eyebrow="Simple pricing" title="Choose the support" script="that fits." intro="Start with the self-guided program or add a little more structure. No long contract and no hidden extras." />
  <section class="section"><div class="container price-grid"><article class="price-card"><p>Self-guided</p><h2>Strong Again</h2><div class="price">R690 <span>once-off</span></div><ul><li>✓ Full eight-week program</li><li>✓ Home and gym alternatives</li><li>✓ General habit and food guidance</li><li>✓ Exercise demonstrations</li><li>✓ Lifetime program access</li></ul><a class="button button-secondary" href="/contact">Ask about the program</a></article><article class="price-card featured"><span class="badge">More support</span><p>Guided</p><h2>Strong Again +</h2><div class="price">R1 490 <span>once-off</span></div><ul><li>✓ Everything in Strong Again</li><li>✓ Four accountability check-ins</li><li>✓ Help choosing program alternatives</li><li>✓ Weekly reflection prompts</li><li>✓ Eight weeks of email encouragement</li></ul><a class="button button-dark" href="/contact">Ask about guided support</a></article></div><p class="pricing-note">Prices and sales terms are placeholders until the final offer, payment provider, refund policy, and access period are confirmed.</p></section>
</BaseLayout>
<style>
  .price-grid { display: grid; max-width: 62rem; gap: 1.25rem; margin-inline: auto; grid-template-columns: repeat(2, 1fr); }
  .price-card { display: flex; min-height: 36rem; flex-direction: column; padding: clamp(1.7rem, 4vw, 2.7rem); border: 1px solid var(--sand); border-radius: var(--radius-lg); background: color-mix(in srgb, var(--sand) 55%, var(--cream)); box-shadow: var(--shadow-sm); }
  .price-card.featured { border: none; background: var(--terracotta); box-shadow: var(--shadow-md); }
  .price-card > p { margin: 0 0 0.7rem; color: var(--caramel); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .featured > p { color: var(--chocolate); }
  .price-card h2 { margin: 0; color: var(--ink); font-family: var(--font-heading); font-size: 2.1rem; }
  .price { margin: 1.5rem 0; color: var(--ink); font-family: var(--font-heading); font-size: 2.5rem; font-weight: 600; }
  .price span { font-family: var(--font-body); font-size: 0.7rem; font-weight: 500; }
  ul { display: grid; gap: 0.85rem; margin: 1rem 0 2.5rem; padding: 0; list-style: none; }
  li { font-size: 0.84rem; }
  .price-card .button { margin-top: auto; }
  .pricing-note { max-width: 46rem; margin: 2rem auto 0; font-size: 0.72rem; text-align: center; }
  @media (max-width: 44rem) { .price-grid { grid-template-columns: 1fr; } }
</style>
