---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const plans = [
  {
    label: 'Self-guided',
    note: 'Move at your own pace',
    name: 'Strong Again',
    price: '690',
    description: 'A practical eight-week plan with clear sessions you can follow at home or in the gym.',
    features: [
      'Full eight-week program',
      'Home and gym alternatives',
      'General habit and food guidance',
      'Exercise demonstrations',
      'Lifetime program access',
    ],
    cta: 'Ask about the program',
    featured: false,
  },
  {
    label: 'Guided',
    note: 'More personal support',
    name: 'Strong Again +',
    price: '1 490',
    description: 'The complete program, with added check-ins and encouragement to help you stay on track.',
    features: [
      'Everything in Strong Again',
      'Four accountability check-ins',
      'Help choosing program alternatives',
      'Weekly reflection prompts',
      'Eight weeks of email encouragement',
    ],
    cta: 'Ask about guided support',
    featured: true,
  },
];
---

<BaseLayout title="Pricing" description="Simple pricing for the Strong Again self-guided program and optional accountability support.">
  <PageHero
    eyebrow="Simple pricing"
    title="Choose the support"
    script="that fits."
    intro="Start with the self-guided program or add a little more structure. No long contract and no hidden extras."
  />

  <section class="section pricing-section" aria-label="Strong Again pricing options">
    <div class="container">
      <div class="pricing-highlights" aria-label="Program highlights">
        <span>One simple payment</span>
        <i aria-hidden="true"></i>
        <span>Eight-week program</span>
        <i aria-hidden="true"></i>
        <span>Lifetime access</span>
      </div>

      <div class="price-grid">
        {plans.map((plan) => (
          <article class:list={['price-card', { featured: plan.featured }]}>
            {plan.featured && <span class="recommendation">More support</span>}

            <header class="plan-header">
              <div class="plan-meta">
                <p class="plan-label">{plan.label}</p>
                <span>{plan.note}</span>
              </div>
              <h2>{plan.name}</h2>
              <p class="plan-description">{plan.description}</p>
            </header>

            <div class="price-row">
              <span class="currency">R</span>
              <strong>{plan.price}</strong>
              <span class="payment-note">once-off<small>No monthly fee</small></span>
            </div>

            <div class="feature-block">
              <p class="includes">What’s included</p>
              <ul>
                {plan.features.map((feature) => (
                  <li><span aria-hidden="true">✓</span>{feature}</li>
                ))}
              </ul>
            </div>

            <a
              class:list={['button', plan.featured ? 'button-dark' : 'button-secondary']}
              href={`/contact?interest=${plan.featured ? 'guided' : 'program'}`}
            >
              {plan.cta}<span class="button-arrow" aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>

      <p class="pricing-note">Prices and sales terms are placeholders until the final offer, payment provider, refund policy, and access period are confirmed.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .pricing-section {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 8% 18%, color-mix(in srgb, var(--sage) 36%, transparent) 0 7rem, transparent 7.1rem),
      radial-gradient(circle at 92% 72%, color-mix(in srgb, var(--terracotta) 25%, transparent) 0 10rem, transparent 10.1rem);
  }

  .pricing-highlights {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 1rem;
    margin: 0 auto 2.25rem;
    padding: 0.72rem 1.2rem;
    border: 1px solid color-mix(in srgb, var(--caramel) 25%, transparent);
    border-radius: var(--radius-pill);
    color: var(--chocolate);
    background: color-mix(in srgb, var(--white) 62%, transparent);
    box-shadow: 0 10px 28px rgb(97 70 53 / 7%);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .pricing-highlights i {
    width: 0.3rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--terracotta);
  }

  .price-grid {
    display: grid;
    max-width: 66rem;
    gap: clamp(1.25rem, 3vw, 2rem);
    margin-inline: auto;
    align-items: stretch;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .price-card {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: 38rem;
    overflow: hidden;
    flex-direction: column;
    padding: clamp(1.6rem, 3.5vw, 2.5rem);
    border: 1px solid color-mix(in srgb, var(--caramel) 32%, transparent);
    border-radius: clamp(1.5rem, 3vw, 2.1rem);
    background: color-mix(in srgb, var(--white) 70%, var(--cream));
    box-shadow: 0 18px 50px rgb(97 70 53 / 13%);
  }

  .price-card::before {
    position: absolute;
    z-index: -1;
    top: -8rem;
    right: -7rem;
    width: 18rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: color-mix(in srgb, var(--sage) 48%, transparent);
    content: '';
    transition: transform 550ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .price-card::after {
    position: absolute;
    z-index: -1;
    top: 0;
    right: 0;
    left: 0;
    height: 5px;
    background: linear-gradient(90deg, var(--caramel), var(--sage));
    content: '';
    transform: scaleX(0.34);
    transform-origin: left;
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .price-card.featured {
    border-color: color-mix(in srgb, var(--chocolate) 22%, transparent);
    background: linear-gradient(150deg, color-mix(in srgb, var(--terracotta) 84%, var(--cream)), var(--terracotta));
    box-shadow: 0 24px 65px rgb(97 70 53 / 22%);
  }

  .price-card.featured::before {
    background: color-mix(in srgb, var(--cream) 26%, transparent);
  }

  .price-card:hover::before { transform: translate(-1.25rem, 1rem) scale(1.08); }
  .price-card:hover::after { transform: scaleX(1); }

  .recommendation {
    position: absolute;
    z-index: 2;
    top: 1.6rem;
    right: 1.6rem;
    display: inline-flex;
    align-items: center;
    padding: 0.48rem 0.85rem;
    border-radius: var(--radius-pill);
    color: var(--ink);
    background: var(--sage);
    box-shadow: 0 8px 20px rgb(97 70 53 / 11%);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .plan-meta {
    display: flex;
    min-height: 2rem;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .plan-label {
    margin: 0;
    color: var(--caramel);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .featured .plan-label { color: var(--chocolate); }

  .plan-meta > span {
    padding-left: 0.75rem;
    border-left: 1px solid color-mix(in srgb, var(--chocolate) 28%, transparent);
    font-size: 0.67rem;
    opacity: 0.78;
  }

  .plan-header h2 {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-heading);
    font-size: clamp(2.1rem, 4vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .plan-description {
    max-width: 31rem;
    min-height: 4.8rem;
    margin: 0.9rem 0 0;
    font-size: 0.78rem;
    line-height: 1.65;
    opacity: 0.85;
  }

  .price-row {
    display: flex;
    align-items: end;
    margin: 1.6rem 0 1.75rem;
    padding: 1.15rem 0;
    border-block: 1px solid color-mix(in srgb, var(--chocolate) 18%, transparent);
    color: var(--ink);
  }

  .currency {
    margin: 0 0.18rem 0.52rem 0;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .price-row strong {
    font-family: var(--font-heading);
    font-size: clamp(2.8rem, 5vw, 3.7rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.9;
  }

  .payment-note {
    display: grid;
    margin-left: 0.8rem;
    font-size: 0.7rem;
    font-weight: 650;
    line-height: 1.35;
  }

  .payment-note small { font-size: 0.58rem; font-weight: 500; opacity: 0.7; }

  .feature-block { margin-bottom: 2rem; }
  .includes { margin: 0 0 0.7rem; color: var(--ink); font-size: 0.7rem; font-weight: 700; }

  ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    align-items: center;
    gap: 0.7rem;
    padding: 0.58rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--chocolate) 12%, transparent);
    font-size: 0.76rem;
    line-height: 1.45;
    grid-template-columns: 1.45rem 1fr;
  }

  li:last-child { border-bottom: 0; }

  li span {
    display: grid;
    width: 1.45rem;
    aspect-ratio: 1;
    place-items: center;
    border-radius: 50%;
    color: var(--chocolate);
    background: var(--sage);
    font-size: 0.68rem;
    font-weight: 800;
    transition: transform 220ms ease;
  }

  .price-card:hover li span { transform: scale(1.06); }

  .price-card .button {
    width: 100%;
    margin-top: auto;
  }

  .button-arrow {
    position: relative;
    z-index: 1;
    font-size: 1.1rem;
    transition: transform 220ms ease;
  }

  .button:hover .button-arrow { transform: translateX(0.28rem); }

  .pricing-note {
    max-width: 47rem;
    margin: 2rem auto 0;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    color: color-mix(in srgb, var(--chocolate) 78%, transparent);
    background: color-mix(in srgb, var(--white) 42%, transparent);
    font-size: 0.66rem;
    line-height: 1.6;
    text-align: center;
  }

  @media (max-width: 52rem) {
    .price-grid { grid-template-columns: 1fr; }
    .price-card { min-height: auto; }
    .plan-description { min-height: auto; }
  }

  @media (max-width: 36rem) {
    .pricing-highlights { width: 100%; flex-wrap: wrap; justify-content: center; gap: 0.55rem 0.8rem; border-radius: var(--radius-md); }
    .pricing-highlights i { display: none; }
    .pricing-highlights span { width: 100%; text-align: center; }
    .recommendation { position: static; width: fit-content; margin: 0 0 1rem auto; }
    .plan-meta { align-items: flex-start; flex-direction: column; gap: 0.2rem; }
    .plan-meta > span { padding-left: 0; border-left: 0; }
  }
</style>
