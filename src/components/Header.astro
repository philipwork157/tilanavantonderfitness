---
import { site } from '../data/site';
const currentPath = Astro.url.pathname;
---
<header class="site-header">
  <div class="container nav-shell">
    <a class="wordmark" href="/" aria-label={`${site.name} home`}>{site.name}</a>
    <nav class="desktop-nav" aria-label="Main navigation">{site.navigation.map((item) => <a class:list={{ active: currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) }} href={item.href}>{item.label}</a>)}</nav>
    <a class="nav-cta" href="/contact">Get in touch</a>
    <details class="mobile-nav"><summary aria-label="Open navigation"><span></span><span></span><span></span></summary><nav aria-label="Mobile navigation">{site.navigation.map((item) => <a href={item.href}>{item.label}</a>)}<a class="mobile-cta" href="/contact">Get in touch</a></nav></details>
  </div>
</header>
<style>
  .site-header { position: relative; z-index: 30; background: var(--cream); }
  .nav-shell { display: grid; min-height: 5.5rem; align-items: center; gap: 2rem; grid-template-columns: 1fr auto 1fr; }
  .wordmark { color: var(--caramel); font-family: var(--font-script); font-size: clamp(2rem, 3vw, 2.5rem); line-height: 1; }
  .desktop-nav { display: flex; align-items: center; gap: 1.6rem; }
  .desktop-nav a { color: var(--ink); font-size: 0.84rem; font-weight: 550; }
  .desktop-nav a:hover, .desktop-nav a.active { color: var(--caramel); }
  .nav-cta { padding: 0.65rem 1.15rem; border-radius: var(--radius-pill); color: var(--ink); background: var(--terracotta); font-size: 0.8rem; font-weight: 650; justify-self: end; transition: background 160ms ease; }
  .nav-cta:hover { background: var(--caramel); }
  .mobile-nav { display: none; }
  @media (max-width: 58rem) {
    .nav-shell { display: flex; justify-content: space-between; }
    .desktop-nav, .nav-cta { display: none; }
    .mobile-nav { display: block; }
    summary { display: grid; width: 2.75rem; height: 2.75rem; place-content: center; gap: 4px; border: 1px solid var(--sand); border-radius: 50%; cursor: pointer; list-style: none; }
    summary::-webkit-details-marker { display: none; }
    summary span { width: 1.1rem; height: 1.5px; background: var(--ink); }
    .mobile-nav nav { position: absolute; top: 5rem; right: var(--page-pad); left: var(--page-pad); display: flex; flex-direction: column; padding: 1rem; border: 1px solid var(--sand); border-radius: var(--radius-md); background: var(--cream); box-shadow: var(--shadow-md); }
    .mobile-nav nav a { padding: 0.8rem 0.5rem; color: var(--ink); font-weight: 550; }
    .mobile-nav .mobile-cta { margin-top: 0.5rem; border-radius: var(--radius-pill); background: var(--terracotta); text-align: center; }
  }
</style>
