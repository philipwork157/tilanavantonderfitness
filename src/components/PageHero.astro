---
interface Props { eyebrow: string; title: string; intro: string; script?: string; }
const { eyebrow, title, intro, script } = Astro.props;
---
<section class="page-hero"><div class="container"><p class="eyebrow">{eyebrow}</p><h1>{title} {script && <span>{script}</span>}</h1><p>{intro}</p></div></section>
<style>
  .page-hero { padding: clamp(4.5rem, 10vw, 8rem) 0; background: color-mix(in srgb, var(--sand) 55%, var(--cream)); text-align: center; }
  h1 { max-width: 14ch; margin: 0 auto; color: var(--ink); font-family: var(--font-heading); font-size: clamp(3rem, 7vw, 5.5rem); font-weight: 600; letter-spacing: -0.04em; line-height: 1; }
  h1 span { display: block; color: var(--caramel); font-family: var(--font-script); font-weight: 400; }
  .page-hero div > p:last-child { max-width: 42rem; margin: 1.5rem auto 0; font-size: clamp(1rem, 1.5vw, 1.1rem); line-height: 1.75; }
</style>
